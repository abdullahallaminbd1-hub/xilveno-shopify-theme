<div class="error-page">
  <p class="error-page__code" aria-hidden="true">404</p>
  <h1 class="error-page__title">{{ 'general.404.title' | t | default: 'Page not found' }}</h1>
  <p class="error-page__text">{{ 'general.404.subtext' | t | default: 'The page you were looking for does not exist. It may have been moved or removed.' }}</p>
  <div style="display:flex;gap:0.75rem;margin-top:1rem;flex-wrap:wrap;justify-content:center;">
    <a href="{{ routes.root_url }}" class="btn btn--primary">Go home</a>
    <a href="{{ routes.root_url }}collections/all" class="btn btn--ghost">Shop all</a>
  </div>
</div>
{% schema %}
{ "name": "404 page", "tag": "section", "settings": [], "presets": [{ "name": "404 page" }] }
{% endschema %}
