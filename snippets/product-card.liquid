<article class="product-card"><a class="product-media" href="{{ product.url }}">{% if product.featured_image %}{{ product.featured_image | image_url: width: 700 | image_tag: loading: 'lazy' }}{% else %}<div class="product-placeholder">LF</div>{% endif %}{% if product.compare_at_price > product.price %}<span class="badge">Sale</span>{% endif %}<button class="quick-add" data-quick-add="{{ product.selected_or_first_available_variant.id }}">{% if product.available %}Quick add +{% else %}Sold out{% endif %}</button></a><div class="product-info"><span class="eyebrow">{{ product.vendor | default: 'LumaForm' }}</span><h3><a href="{{ product.url }}">{{ product.title }}</a></h3><div><strong>{{ product.price | money }}</strong>{% if product.compare_at_price > product.price %}<s>{{ product.compare_at_price | money }}</s>{% endif %}</div></div></article>