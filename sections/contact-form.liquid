<section class="section-padding" id="contact-{{ section.id }}">
  <div class="page-container">
    <div class="contact-grid">
      <div>
        <h2 class="h3" style="margin-bottom:1.5rem;">{{ section.settings.heading | default: "We'd love to hear from you" }}</h2>
        {%- if section.settings.intro != blank -%}<p style="color:var(--color-fg-muted);margin-bottom:2rem;line-height:1.65;">{{ section.settings.intro }}</p>{%- endif -%}
        <div>
          {%- if section.settings.email != blank -%}
            <div class="contact-info__item">
              <div class="contact-info__icon"><svg width="18" height="18" viewBox="0 0 18 18" fill="none" stroke="currentColor" stroke-width="1.5" aria-hidden="true"><rect x="2" y="4" width="14" height="10" rx="2"/><path d="M2 7l7 4 7-4"/></svg></div>
              <div><p style="font-weight:500;font-size:0.875rem;">Email</p><a href="mailto:{{ section.settings.email }}" style="color:var(--color-fg-muted);font-size:0.875rem;">{{ section.settings.email }}</a></div>
            </div>
          {%- endif -%}
          {%- if section.settings.response_time != blank -%}
            <div class="contact-info__item">
              <div class="contact-info__icon"><svg width="18" height="18" viewBox="0 0 18 18" fill="none" stroke="currentColor" stroke-width="1.5" aria-hidden="true"><circle cx="9" cy="9" r="7"/><path d="M9 5v4l3 2" stroke-linecap="round"/></svg></div>
              <div><p style="font-weight:500;font-size:0.875rem;">Response time</p><p style="color:var(--color-fg-muted);font-size:0.875rem;">{{ section.settings.response_time }}</p></div>
            </div>
          {%- endif -%}
        </div>
      </div>
      <div>
        {%- form 'contact', id: 'contact-form' -%}
          {%- if form.posted_successfully? -%}
            <div role="status" style="background:#f0fdf4;border:1px solid #86efac;border-radius:var(--radius-lg);padding:1.25rem;margin-bottom:1.25rem;font-size:0.9rem;color:#15803d;">
              ✓ {{ 'contact.form.post_success' | t | default: "Thank you! We'll be in touch shortly." }}
            </div>
          {%- endif -%}
          {%- if form.errors -%}
            <div role="alert" style="background:#fef2f2;border:1px solid #fca5a5;border-radius:var(--radius-lg);padding:1rem;margin-bottom:1.25rem;font-size:0.875rem;color:#991b1b;">
              {{ form.errors | default_errors }}
            </div>
          {%- endif -%}
          <div style="display:flex;flex-direction:column;gap:1rem;">
            <div style="display:grid;grid-template-columns:1fr 1fr;gap:1rem;">
              <div class="field"><label class="field__label" for="contact-name">{{ 'contact.form.name' | t | default: 'Name' }}</label><input type="text" id="contact-name" name="contact[name]" value="{{ form.name }}" class="field__input" autocomplete="name" required></div>
              <div class="field"><label class="field__label" for="contact-email">{{ 'contact.form.email' | t | default: 'Email' }}</label><input type="email" id="contact-email" name="contact[email]" value="{{ form.email }}" class="field__input" autocomplete="email" required></div>
            </div>
            <div class="field"><label class="field__label" for="contact-subject">Subject</label><input type="text" id="contact-subject" name="contact[subject]" class="field__input"></div>
            <div class="field"><label class="field__label" for="contact-body">{{ 'contact.form.message' | t | default: 'Message' }}</label><textarea id="contact-body" name="contact[body]" class="field__textarea" rows="5" required></textarea></div>
            <button type="submit" class="btn btn--primary">{{ 'contact.form.send' | t | default: 'Send message' }}</button>
          </div>
        {%- endform -%}
      </div>
    </div>
  </div>
</section>
<style>@media(max-width:768px){#contact-{{ section.id }} .contact-grid{grid-template-columns:1fr!important;} #contact-{{ section.id }} [style*="grid-template-columns:1fr 1fr"]{grid-template-columns:1fr!important;}}</style>
{% schema %}
{
  "name": "Contact form",
  "tag": "section",
  "settings": [
    { "type": "text", "id": "heading", "label": "Heading", "default": "We'd love to hear from you" },
    { "type": "textarea", "id": "intro", "label": "Intro text", "default": "Have a question about an order, product, or anything else? We're here to help." },
    { "type": "text", "id": "email", "label": "Contact email", "default": "hello@xilveno.com" },
    { "type": "text", "id": "response_time", "label": "Response time", "default": "We reply within 24–48 hours" }
  ],
  "presets": [{ "name": "Contact form" }]
}
{% endschema %}
