[
  {
    "name": "theme_info",
    "theme_name": "Xilveno",
    "theme_version": "1.0.1",
    "theme_author": "Xilveno",
    "theme_documentation_url": "https://xilveno.com",
    "theme_support_url": "https://xilveno.com/pages/contact"
  },
  {
    "name": "Colors",
    "settings": [
      {
        "type": "header",
        "content": "Color scheme"
      },
      {
        "type": "select",
        "id": "color_scheme",
        "label": "Color scheme",
        "options": [
          { "value": "scheme-1", "label": "Light (default)" },
          { "value": "scheme-2", "label": "Dark" }
        ],
        "default": "scheme-1"
      },
      {
        "type": "header",
        "content": "Brand colors"
      },
      {
        "type": "color",
        "id": "color_primary",
        "label": "Primary (text / buttons)",
        "default": "#0a0a0a"
      },
      {
        "type": "color",
        "id": "color_background",
        "label": "Page background",
        "default": "#ffffff"
      },
      {
        "type": "color",
        "id": "color_accent",
        "label": "Accent color",
        "default": "#0a0a0a"
      },
      {
        "type": "color",
        "id": "color_surface",
        "label": "Surface / card background",
        "default": "#f9fafb"
      },
      {
        "type": "color",
        "id": "color_border",
        "label": "Border color",
        "default": "#e5e7eb"
      },
      {
        "type": "color",
        "id": "color_error",
        "label": "Error color",
        "default": "#dc2626"
      },
      {
        "type": "color",
        "id": "color_success",
        "label": "Success color",
        "default": "#16a34a"
      }
    ]
  },
  {
    "name": "Typography",
    "settings": [
      {
        "type": "header",
        "content": "Headings"
      },
      {
        "type": "font_picker",
        "id": "type_header_font",
        "label": "Heading font",
        "default": "inter_n4"
      },
      {
        "type": "range",
        "id": "heading_scale",
        "min": 75,
        "max": 150,
        "step": 5,
        "unit": "%",
        "label": "Heading size scale",
        "default": 100
      },
      {
        "type": "header",
        "content": "Body text"
      },
      {
        "type": "font_picker",
        "id": "type_body_font",
        "label": "Body font",
        "default": "inter_n4"
      },
      {
        "type": "range",
        "id": "body_font_size",
        "min": 14,
        "max": 18,
        "step": 1,
        "unit": "px",
        "label": "Body font size",
        "default": 16
      }
    ]
  },
  {
    "name": "Layout",
    "settings": [
      {
        "type": "range",
        "id": "page_width",
        "min": 1000,
        "max": 1600,
        "step": 50,
        "unit": "px",
        "label": "Page width",
        "default": 1400
      },
      {
        "type": "range",
        "id": "spacing_sections",
        "min": 20,
        "max": 100,
        "step": 4,
        "unit": "px",
        "label": "Section vertical spacing",
        "default": 60
      },
      {
        "type": "select",
        "id": "button_style",
        "label": "Button corner style",
        "options": [
          { "value": "square", "label": "Square" },
          { "value": "rounded", "label": "Rounded" },
          { "value": "pill", "label": "Pill" }
        ],
        "default": "square"
      }
    ]
  },
  {
    "name": "Favicon",
    "settings": [
      {
        "type": "image_picker",
        "id": "favicon",
        "label": "Favicon image",
        "info": "32×32px .png recommended"
      }
    ]
  },
  {
    "name": "Social media",
    "settings": [
      {
        "type": "url",
        "id": "social_instagram_url",
        "label": "Instagram URL"
      },
      {
        "type": "url",
        "id": "social_tiktok_url",
        "label": "TikTok URL"
      },
      {
        "type": "url",
        "id": "social_facebook_url",
        "label": "Facebook URL"
      },
      {
        "type": "url",
        "id": "social_pinterest_url",
        "label": "Pinterest URL"
      },
      {
        "type": "url",
        "id": "social_youtube_url",
        "label": "YouTube URL"
      },
      {
        "type": "url",
        "id": "social_twitter_url",
        "label": "Twitter / X URL"
      }
    ]
  },
  {
    "name": "Cart",
    "settings": [
      {
        "type": "range",
        "id": "free_shipping_threshold",
        "min": 0,
        "max": 20000,
        "step": 100,
        "unit": "cents",
        "label": "Free shipping threshold (in cents, 0 = disabled)",
        "info": "e.g. 5000 = $50.00. Set to 0 to hide the progress bar.",
        "default": 5000
      }
    ]
  },
  {
    "name": "Animations",
    "settings": [
      {
        "type": "select",
        "id": "animation_level",
        "label": "Animation level",
        "options": [
          { "value": "none", "label": "None (fastest)" },
          { "value": "subtle", "label": "Subtle" },
          { "value": "moderate", "label": "Moderate" },
          { "value": "full", "label": "Full (default)" }
        ],
        "default": "full",
        "info": "Reduce or disable animations for performance or accessibility. prefers-reduced-motion is always respected regardless of this setting."
      }
    ]
  },
  {
    "name": "SEO & sharing",
    "settings": [
      {
        "type": "image_picker",
        "id": "share_image",
        "label": "Default social sharing image",
        "info": "1200×630px recommended. Used when no product/article image is available."
      }
    ]
  },
  {
    "name": "Product cards",
    "settings": [
      {
        "type": "checkbox",
        "id": "show_vendor",
        "label": "Show product vendor",
        "default": true
      },
      {
        "type": "checkbox",
        "id": "show_rating",
        "label": "Show star ratings on cards",
        "info": "Requires a reviews app with metafield support.",
        "default": false
      },
      {
        "type": "select",
        "id": "card_image_ratio",
        "label": "Product image aspect ratio",
        "options": [
          { "value": "square", "label": "Square (1:1)" },
          { "value": "portrait", "label": "Portrait (3:4)" },
          { "value": "tall", "label": "Tall (2:3)" }
        ],
        "default": "portrait"
      },
      {
        "type": "select",
        "id": "card_hover",
        "label": "Card hover effect",
        "options": [
          { "value": "quick-add", "label": "Quick add button" },
          { "value": "second-image", "label": "Swap to second image" },
          { "value": "zoom", "label": "Image zoom only" }
        ],
        "default": "quick-add"
      }
    ]
  }
]