<div class="drawer-backdrop" data-drawer-close></div>
<aside class="cart-drawer" aria-label="Cart" aria-hidden="true" data-cart-drawer>
  <header class="drawer__header"><div><span class="eyebrow">LumaForm / your edit</span><h2>Cart <span data-cart-count>{{ cart.item_count }}</span></h2></div><button class="icon-button" data-drawer-close aria-label="Close cart">{% render 'icon', icon: 'close' %}</button></header>
  <div class="gift-panel"><span class="gift-panel__mark">✦</span><div><strong>Complimentary gift</strong><p>Spend $75 or more and choose one tool with our compliments.</p><div class="gift-choices" data-gift-choices><button type="button" data-gift-choice="Contour cooling wand">Cooling wand</button><button type="button" data-gift-choice="Precision facial roller">Facial roller</button><button type="button" data-gift-choice="Travel tool set">Travel set</button></div><small data-gift-status>Choose one qualifying gift at checkout.</small></div></div>
  <div class="drawer__body" data-cart-body>
    <div class="shipping-progress"><span>Free shipping unlocked at <strong>$75</strong></span><div><i style="width:{{ cart.total_price | divided_by: 75.0 | at_most: 100 }}%"></i></div><small>Add more to unlock your shipping benefit.</small></div>
    {% if cart.item_count == 0 %}<div class="empty-state"><div class="empty-state__mark">◇</div><h3>Your cart is empty</h3><p>Discover a small upgrade for your daily ritual.</p><a class="button button--dark" href="{{ routes.all_products_collection_url }}">Continue shopping</a></div>{% else %}{% for item in cart.items %}<div class="cart-item"><div class="cart-item__image">{% if item.image %}{{ item.image | image_url: width: 180 | image_tag }}{% endif %}</div><div class="cart-item__details"><h3>{{ item.product.title }}</h3><p>{{ item.final_line_price | money }}</p><div class="quantity-control"><button type="button" data-cart-change data-line="{{ item.key }}" data-quantity="{{ item.quantity | minus: 1 }}" aria-label="Decrease quantity of {{ item.product.title | escape }}">−</button><span>{{ item.quantity }}</span><button type="button" data-cart-change data-line="{{ item.key }}" data-quantity="{{ item.quantity | plus: 1 }}" aria-label="Increase quantity of {{ item.product.title | escape }}">＋</button></div><a href="{{ item.url_to_remove }}" data-remove-item data-line="{{ item.key }}">Remove</a></div></div>{% endfor %}{% endif %}
    <div class="drawer-recommendations"><span class="eyebrow">You may also like</span><div><a href="{{ routes.all_products_collection_url }}">Facial tools</a><a href="{{ routes.all_products_collection_url }}">Hair tools</a><a href="{{ routes.all_products_collection_url }}">Gift sets</a></div></div>
  </div>
  <footer class="drawer__footer"><p class="cart-note" data-discount-note aria-live="polite"></p><form class="discount-form" data-discount-form><input type="text" name="discount" placeholder="Enter your discount code" aria-label="Discount code"><button type="submit">Apply</button></form><div class="drawer-total"><span>Subtotal</span><strong>{{ cart.total_price | money }}</strong></div><a class="button button--accent button--full" href="{{ routes.checkout_url }}">Checkout <span>→</span></a><p class="payment-note">Taxes and shipping calculated at checkout<br>Visa · Mastercard · Amex · Shop Pay</p></footer>
</aside>