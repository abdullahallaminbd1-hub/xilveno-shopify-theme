<div
  class="hero-slideshow"
  data-autoplay="{{ section.settings.autoplay }}"
  data-interval="{{ section.settings.autoplay_speed | times: 1000 }}"
  aria-label="{{ 'sections.hero_slideshow.label' | t | default: 'Hero slideshow' }}"
  aria-roledescription="carousel"
>
  <div class="hero-slideshow__track" role="list">
    {%- for block in section.blocks -%}
      {%- if block.type == 'slide' -%}
        {%- if forloop.first -%}
          {%- assign slide_loading = 'eager' -%}
          {%- assign slide_fetchpriority = 'high' -%}
        {%- else -%}
          {%- assign slide_loading = 'lazy' -%}
          {%- assign slide_fetchpriority = 'auto' -%}
        {%- endif -%}
        <div
          class="hero-slide"
          role="listitem"
          aria-roledescription="slide"
          aria-label="{{ forloop.index }} of {{ section.blocks.size }}"
          aria-hidden="{% if forloop.first %}false{% else %}true{% endif %}"
          {{ block.shopify_attributes }}
        >
          {%- if block.settings.image != blank -%}
            {%- assign slide_image_600 = block.settings.image | image_url: width: 600 -%}
            {%- assign slide_image_1200 = block.settings.image | image_url: width: 1200 -%}
            {%- assign slide_image_2000 = block.settings.image | image_url: width: 2000 -%}
            <img
              class="hero-slide__bg"
              src="{{ slide_image_2000 }}"
              srcset="{{ slide_image_600 }} 600w, {{ slide_image_1200 }} 1200w, {{ slide_image_2000 }} 2000w"
              sizes="100vw"
              alt="{{ block.settings.image.alt | escape }}"
              loading="{{ slide_loading }}"
              fetchpriority="{{ slide_fetchpriority }}"
              width="2000"
              height="1125"
            >
          {%- else -%}
            <div class="hero-slide__bg" style="background:{{ block.settings.bg_color | default: '#1a1a2e' }};"></div>
          {%- endif -%}

          {%- if block.settings.overlay_opacity > 0 -%}
            <div
              class="hero-slide__overlay"
              style="background:linear-gradient(to right, rgba(0,0,0,{{ block.settings.overlay_opacity | divided_by: 100.0 }}) 0%, rgba(0,0,0,{{ block.settings.overlay_opacity | divided_by: 200.0 }}) 60%, transparent 100%);"
              aria-hidden="true"
            ></div>
          {%- endif -%}

          <div class="hero-slide__content" style="text-align:{{ block.settings.content_align }};">
            {%- if block.settings.eyebrow != blank -%}
              <p class="hero-slide__eyebrow animate-on-scroll">{{ block.settings.eyebrow }}</p>
            {%- endif -%}

            {%- if block.settings.heading != blank -%}
              <h2 class="hero-slide__heading animate-on-scroll animate-on-scroll--delay-1" style="max-width:{{ block.settings.heading_max_width }}px;">
                {{ block.settings.heading }}
              </h2>
            {%- endif -%}

            {%- if block.settings.subheading != blank -%}
              <p class="hero-slide__subheading animate-on-scroll animate-on-scroll--delay-2">{{ block.settings.subheading }}</p>
            {%- endif -%}

            {%- if block.settings.btn1_label != blank or block.settings.btn2_label != blank -%}
              <div class="hero-slide__actions animate-on-scroll animate-on-scroll--delay-3">
                {%- if block.settings.btn1_label != blank -%}
                  <a
                    href="{{ block.settings.btn1_link | default: '#' }}"
                    class="hero-slide__btn hero-slide__btn--primary"
                  >
                    {{ block.settings.btn1_label }}
                  </a>
                {%- endif -%}
                {%- if block.settings.btn2_label != blank -%}
                  <a
                    href="{{ block.settings.btn2_link | default: '#' }}"
                    class="hero-slide__btn hero-slide__btn--secondary"
                  >
                    {{ block.settings.btn2_label }}
                  </a>
                {%- endif -%}
              </div>
            {%- endif -%}
          </div>
        </div>
      {%- endif -%}
    {%- endfor -%}
  </div>

  {%- if section.blocks.size > 1 -%}
    <button class="hero-slideshow__arrow hero-slideshow__arrow--prev" aria-label="{{ 'sections.slideshow.previous_slide' | t | default: 'Previous slide' }}">
      <svg width="20" height="20" viewBox="0 0 20 20" fill="none" aria-hidden="true">
        <path d="M13 4L7 10l6 6" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"/>
      </svg>
    </button>
    <button class="hero-slideshow__arrow hero-slideshow__arrow--next" aria-label="{{ 'sections.slideshow.next_slide' | t | default: 'Next slide' }}">
      <svg width="20" height="20" viewBox="0 0 20 20" fill="none" aria-hidden="true">
        <path d="M7 4l6 6-6 6" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"/>
      </svg>
    </button>
    <div class="hero-slideshow__nav" role="tablist" aria-label="{{ 'sections.slideshow.slide_dots' | t | default: 'Slide navigation' }}">
      {%- for block in section.blocks -%}
        {%- if block.type == 'slide' -%}
          <button
            class="hero-slideshow__dot{% if forloop.first %} is-active{% endif %}"
            role="tab"
            aria-selected="{{ forloop.first }}"
            aria-label="{{ 'sections.slideshow.slide_label' | t: index: forloop.index | default: 'Go to slide ' | append: forloop.index }}"
          ></button>
        {%- endif -%}
      {%- endfor -%}
    </div>
  {%- endif -%}
</div>

{% schema %}
{
  "name": "Hero slideshow",
  "tag": "section",
  "settings": [
    {
      "type": "checkbox",
      "id": "autoplay",
      "label": "Auto-rotate slides",
      "default": true
    },
    {
      "type": "range",
      "id": "autoplay_speed",
      "min": 3,
      "max": 10,
      "step": 1,
      "unit": "s",
      "label": "Change slides every",
      "default": 5
    }
  ],
  "blocks": [
    {
      "type": "slide",
      "name": "Slide",
      "settings": [
        {
          "type": "image_picker",
          "id": "image",
          "label": "Image"
        },
        {
          "type": "color",
          "id": "bg_color",
          "label": "Fallback background color",
          "default": "#1a1a2e"
        },
        {
          "type": "range",
          "id": "overlay_opacity",
          "min": 0,
          "max": 80,
          "step": 5,
          "unit": "%",
          "label": "Image overlay opacity",
          "default": 45
        },
        {
          "type": "select",
          "id": "content_align",
          "label": "Content alignment",
          "options": [
            { "value": "left", "label": "Left" },
            { "value": "center", "label": "Center" }
          ],
          "default": "left"
        },
        {
          "type": "text",
          "id": "eyebrow",
          "label": "Eyebrow text",
          "default": "New Collection"
        },
        {
          "type": "textarea",
          "id": "heading",
          "label": "Heading",
          "default": "Discover More.\nLive Better."
        },
        {
          "type": "range",
          "id": "heading_max_width",
          "min": 300,
          "max": 900,
          "step": 50,
          "unit": "px",
          "label": "Heading max width",
          "default": 600
        },
        {
          "type": "text",
          "id": "subheading",
          "label": "Subheading",
          "default": "Premium products for everyday living."
        },
        {
          "type": "text",
          "id": "btn1_label",
          "label": "Button 1 label",
          "default": "Shop now"
        },
        {
          "type": "url",
          "id": "btn1_link",
          "label": "Button 1 link"
        },
        {
          "type": "text",
          "id": "btn2_label",
          "label": "Button 2 label"
        },
        {
          "type": "url",
          "id": "btn2_link",
          "label": "Button 2 link"
        }
      ]
    }
  ],
  "presets": [
    {
      "name": "Hero slideshow",
      "blocks": [
        {
          "type": "slide",
          "settings": {
            "eyebrow": "New Arrivals",
            "heading": "Discover More.\nLive Better.",
            "subheading": "Premium everyday essentials for the modern home.",
            "btn1_label": "Shop now",
            "btn1_link": "/collections/all",
            "btn2_label": "Explore collections"
          }
        },
        {
          "type": "slide",
          "settings": {
            "eyebrow": "Fashion & Style",
            "heading": "Dress for the\nLife You Want.",
            "btn1_label": "Shop fashion",
            "btn1_link": "/collections/fashion"
          }
        }
      ]
    }
  ]
}
{% endschema %}
