<section class="collection-page"><div class="page-intro"><span class="eyebrow">Curated tools / {{ collection.products_count }} pieces</span><h1>{{ collection.title }}</h1><p>Beauty devices, facial tools, hair accessories, and personal-care essentials selected for modern routines.</p></div><div class="collection-toolbar"><button data-filter-open>Filter ＋</button><span>{{ collection.products_count }} products</span><form><label>Sort by <select name="sort_by" onchange="this.form.submit()"><option value="manual">Featured</option><option value="price-ascending">Price, low to high</option><option value="price-descending">Price, high to low</option></select></label></form></div><div class="collection-layout"><aside class="filter-panel" data-filter-panel><button data-filter-close>Close ×</button><b>Filter</b><label><input type="checkbox"> In stock</label><label><input type="checkbox"> Facial tools</label><label><input type="checkbox"> Beauty devices</label><label><input type="checkbox"> Under $25</label></aside><div class="collection-results"><div class="product-grid">{% for product in collection.products %}{% render 'product-card', product: product %}{% else %}<p>No products yet. Add products in Shopify Admin.</p>{% endfor %}</div>{{ paginate | default: '' }}</div></div></section>{% schema %}{"name":"Collection grid","settings":[],"presets":[{"name":"Collection grid"}]}{% endschema %}