<section class="section-padding" id="recently-viewed-{{ section.id }}" style="display:none;">
  <div class="page-container">
    <div class="section-header">
      <h2 class="section-title h3">{{ section.settings.heading | default: 'Recently viewed' }}</h2>
    </div>
    <div class="products-grid products-grid--wide" id="recently-viewed-grid" aria-live="polite" aria-label="Recently viewed products"></div>
  </div>
</section>

<script>
document.addEventListener('DOMContentLoaded', function() {
  var section = document.getElementById('recently-viewed-{{ section.id }}');
  var grid = document.getElementById('recently-viewed-grid');
  if (!section || !grid) return;

  var currentId = {{ product.id | default: 'null' }};
  var items = [];
  try { items = JSON.parse(localStorage.getItem('xilveno_recently_viewed') || '[]'); } catch(e) {}
  items = items.filter(function(p) { return p.id !== currentId; }).slice(0, {{ section.settings.limit | default: 4 }});

  if (!items.length) return;
  section.style.display = 'block';

  grid.innerHTML = items.map(function(p) {
    var price = p.price ? ('$' + (p.price / 100).toFixed(2)) : '';
    var img = p.image ? '<img src="' + p.image.replace(/\.\w+(\?.*)?$/, function(m) { return '_400x533' + m; }) + '" alt="' + (p.title || '') + '" loading="lazy" width="400" height="533" style="width:100%;height:100%;object-fit:cover;">' : '';
    return '<article class="product-card"><div class="product-card__media" style="aspect-ratio:3/4;background:var(--color-surface);overflow:hidden;border-radius:var(--radius-lg);"><a href="' + p.url + '">' + img + '</a></div><div class="product-card__info"><a href="' + p.url + '" class="product-card__title">' + (p.title || '') + '</a><div class="product-card__price-wrap"><span class="product-card__price">' + price + '</span></div></div></article>';
  }).join('');
});
</script>

{% schema %}
{
  "name": "Recently viewed",
  "tag": "section",
  "settings": [
    { "type": "text", "id": "heading", "label": "Heading", "default": "Recently viewed" },
    { "type": "range", "id": "limit", "min": 2, "max": 8, "step": 1, "label": "Max products to show", "default": 4 }
  ],
  "presets": [{ "name": "Recently viewed" }]
}
{% endschema %}
