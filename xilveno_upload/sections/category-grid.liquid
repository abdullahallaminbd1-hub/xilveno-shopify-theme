<section class="section-padding" aria-labelledby="category-grid-{{ section.id }}">
  <div class="page-container">
    {%- if section.settings.heading != blank or section.settings.eyebrow != blank -%}
      <div class="section-header{% if section.settings.heading_align == 'center' %} section-header--center{% endif %}">
        {%- if section.settings.eyebrow != blank -%}<span class="section-eyebrow animate-on-scroll">{{ section.settings.eyebrow }}</span>{%- endif -%}
        {%- if section.settings.heading != blank -%}
          <h2 class="section-title h2 animate-on-scroll animate-on-scroll--delay-1" id="category-grid-{{ section.id }}">{{ section.settings.heading }}</h2>
        {%- endif -%}
      </div>
    {%- endif -%}
    <div class="category-grid" data-stagger>
      {%- for block in section.blocks -%}
        {%- if block.type == 'category' -%}
          <a href="{{ block.settings.link | default: '#' }}" class="category-card" {{ block.shopify_attributes }} aria-label="{{ block.settings.name }}">
            {%- if block.settings.image != blank -%}
              {{ block.settings.image | image_url: width: 800 | image_tag: class: 'category-card__image', alt: block.settings.name, loading: 'lazy', width: 800, height: 1067 }}
            {%- else -%}
              <div class="category-card__image" style="background:var(--color-surface-2);"></div>
            {%- endif -%}
            <div class="category-card__overlay" aria-hidden="true"></div>
            <div class="category-card__content">
              <p class="category-card__name">{{ block.settings.name }}</p>
              {%- if block.settings.count != blank -%}<p class="category-card__count">{{ block.settings.count }}</p>{%- endif -%}
              <span class="category-card__arrow" aria-hidden="true">
                <svg width="16" height="16" viewBox="0 0 16 16" fill="none"><path d="M3 8h10M9 4l4 4-4 4" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"/></svg>
              </span>
            </div>
          </a>
        {%- endif -%}
      {%- endfor -%}
    </div>
  </div>
</section>

{% schema %}
{
  "name": "Category grid",
  "tag": "section",
  "settings": [
    { "type": "select", "id": "heading_align", "label": "Heading alignment", "options": [{ "value": "left", "label": "Left" }, { "value": "center", "label": "Center" }], "default": "left" },
    { "type": "text", "id": "eyebrow", "label": "Eyebrow text" },
    { "type": "text", "id": "heading", "label": "Heading", "default": "Shop by Category" }
  ],
  "blocks": [
    {
      "type": "category",
      "name": "Category",
      "settings": [
        { "type": "image_picker", "id": "image", "label": "Image" },
        { "type": "text", "id": "name", "label": "Category name", "default": "Fashion" },
        { "type": "text", "id": "count", "label": "Product count label", "default": "120+ products" },
        { "type": "url", "id": "link", "label": "Link" }
      ]
    }
  ],
  "presets": [
    {
      "name": "Category grid",
      "blocks": [
        { "type": "category", "settings": { "name": "Fashion", "count": "150+ products", "link": "/collections/fashion" } },
        { "type": "category", "settings": { "name": "Home & Kitchen", "count": "200+ products", "link": "/collections/home-kitchen" } },
        { "type": "category", "settings": { "name": "Beauty", "count": "90+ products", "link": "/collections/beauty" } },
        { "type": "category", "settings": { "name": "Kids", "count": "80+ products", "link": "/collections/kids" } }
      ]
    }
  ]
}
{% endschema %}
