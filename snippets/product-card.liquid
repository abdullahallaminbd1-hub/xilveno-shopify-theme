{%- comment -%}
  Renders a product card.
  Usage: {%- render 'product-card', product: product -%}
{%- endcomment -%}

{%- assign card_product = product -%}
{%- assign first_variant = card_product.first_available_variant | default: card_product.variants.first -%}
{%- assign on_sale = false -%}
{%- if card_product.compare_at_price > card_product.price -%}
  {%- assign on_sale = true -%}
{%- endif -%}

<article class="product-card" aria-label="{{ card_product.title | escape }}">

  <div class="product-card__media">
    <a href="{{ card_product.url }}" class="product-card__image-link" tabindex="-1" aria-hidden="true">
      {%- if card_product.featured_image != blank -%}
        {%- assign card_image_300 = card_product.featured_image | image_url: width: 300 -%}
        {%- assign card_image_600 = card_product.featured_image | image_url: width: 600 -%}
        <img
          class="product-card__image product-card__image--primary"
          src="{{ card_image_600 }}"
          srcset="{{ card_image_300 }} 300w, {{ card_image_600 }} 600w"
          sizes="(min-width: 750px) 25vw, 50vw"
          alt="{{ card_product.featured_image.alt | escape }}"
          loading="lazy"
          width="600"
          height="800"
        >
        {%- if card_product.images[1] != blank -%}
          {%- assign card_secondary_image = card_product.images[1] | image_url: width: 600 -%}
          <img
            class="product-card__image product-card__image--secondary"
            src="{{ card_secondary_image }}"
            alt="{{ card_product.images[1].alt | escape }}"
            loading="lazy"
            width="600"
            height="800"
          >
        {%- endif -%}
      {%- else -%}
        {{ 'product-1' | placeholder_svg_tag: 'product-card__image product-card__image--primary placeholder-svg' }}
      {%- endif -%}
    </a>

    {%- comment -%} Badges {%- endcomment -%}
    <div class="product-card__badges" aria-label="Product badges">
      {%- if on_sale -%}
        {%- assign saving_pct = card_product.compare_at_price | minus: card_product.price | times: 100 | divided_by: card_product.compare_at_price -%}
        <span class="badge badge--sale">-{{ saving_pct }}%</span>
      {%- endif -%}
      {%- unless card_product.available -%}
        <span class="badge badge--sold-out">Sold out</span>
      {%- endunless -%}
      {%- if card_product.tags contains 'new' or card_product.tags contains 'New' -%}
        <span class="badge badge--new">New</span>
      {%- endif -%}
    </div>

    {%- comment -%} Quick add & wishlist {%- endcomment -%}
    <div class="product-card__actions" aria-label="Quick actions">
      {%- if card_product.available -%}
        <button
          class="product-card__quick-add"
          data-quick-add="{{ first_variant.id }}"
          aria-label="{{ 'products.product.add_to_cart' | t | default: 'Add to cart' }}: {{ card_product.title | escape }}"
        >
          Quick add
        </button>
      {%- else -%}
        <span class="product-card__quick-add" style="opacity:0.5;cursor:default;">Sold out</span>
      {%- endif -%}
      <button
        class="product-card__wishlist"
        data-wishlist-btn="{{ card_product.id }}"
        data-wishlist-title="{{ card_product.title | escape }}"
        data-wishlist-url="{{ card_product.url }}"
        data-wishlist-price="{{ card_product.price }}"
        data-wishlist-image="{{ card_product.featured_image | image_url: width: 400 }}"
        data-wishlist-vendor="{{ card_product.vendor | escape }}"
        aria-label="Save to wishlist"
      >
        <svg width="16" height="16" viewBox="0 0 16 16" fill="none" aria-hidden="true" data-wishlist-icon>
          <path d="M13.9 3.1a4 4 0 0 0-5.65 0L8 3.35l-.25-.25a4 4 0 0 0-5.65 5.65l.25.25L8 14.65l5.65-5.65.25-.25a4 4 0 0 0 0-5.65z" stroke="currentColor" stroke-width="1.3" stroke-linejoin="round"/>
        </svg>
      </button>
    </div>
  </div>

  {%- comment -%} Info {%- endcomment -%}
  <div class="product-card__info">
    {%- if card_product.vendor != blank -%}
      <p class="product-card__vendor">{{ card_product.vendor }}</p>
    {%- endif -%}
    <a href="{{ card_product.url }}" class="product-card__title">{{ card_product.title }}</a>
    <div class="product-card__price-wrap">
      {%- if on_sale -%}
        <span class="product-card__price product-card__price--sale">{{ card_product.price | money }}</span>
        <span class="product-card__price product-card__price--compare">{{ card_product.compare_at_price | money }}</span>
      {%- else -%}
        <span class="product-card__price">{{ card_product.price | money }}</span>
        {%- if card_product.price_varies -%}
          <span class="product-card__price" style="font-weight:400;color:var(--color-fg-muted);">From</span>
        {%- endif -%}
      {%- endif -%}
    </div>
  </div>

</article>
