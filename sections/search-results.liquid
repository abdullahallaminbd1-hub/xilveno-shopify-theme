<section class="search-page"><div class="page-intro"><span class="eyebrow">Find your next ritual tool</span><h1>Search</h1><form class="search-form" action="{{ routes.search_url }}"><input name="q" value="{{ search.terms | escape }}" placeholder="Search beauty tools and devices"><button class="button dark">Search →</button></form></div>{% if search.performed %}<div class="product-grid">{% for item in search.results %}{% if item.object_type == 'product' %}{% render 'product-card', product: item %}{% endif %}{% else %}<div class="empty-state"><h2>No tools found</h2></div>{% endfor %}</div>{% endif %}</section>{% schema %}{"name":"Search results","settings":[],"presets":[{"name":"Search results"}]}{% endschema %}