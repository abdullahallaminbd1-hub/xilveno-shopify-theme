<div class="password-page">
  <div class="password-page__content">
    <a href="{{ routes.root_url }}" class="password-page__logo">{{ shop.name }}</a>

    <h1 class="password-page__title">Something big is coming.</h1>
    <p class="password-page__text">We're putting the finishing touches on something amazing. Enter your email below and we'll let you know when we launch.</p>

    {%- form 'customer', id: 'coming-soon-form' -%}
      <input type="hidden" name="contact[tags]" value="coming-soon">
      {%- if form.posted_successfully? -%}
        <p style="color:#4ade80;font-weight:500;font-size:1rem;">✓ You're on the list! We'll be in touch.</p>
      {%- else -%}
        <div class="password-form">
          <input
            type="email"
            name="contact[email]"
            class="password-input"
            placeholder="Enter your email address"
            required
            autocomplete="email"
            aria-label="Email address"
          >
          <button type="submit" class="password-btn">Notify me</button>
        </div>
      {%- endif -%}
    {%- endform -%}

    <p style="margin-top:2.5rem;font-size:0.8125rem;opacity:0.5;">
      Are you the store owner?
      <a href="{{ routes.root_url }}password" style="color:inherit;text-decoration:underline;text-underline-offset:2px;">Enter store password</a>
    </p>
  </div>

  <footer class="password-page__footer">
    &copy; {{ 'now' | date: '%Y' }} {{ shop.name }}. Powered by Shopify.
  </footer>
</div>

