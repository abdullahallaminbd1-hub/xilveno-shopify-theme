<section class="section-padding" id="mc-{{ section.id }}">
  <div class="page-container">
    {%- if section.settings.heading != blank -%}
      <div class="section-header section-header--center" style="margin-bottom:2rem;">
        {%- if section.settings.eyebrow != blank -%}<span class="section-eyebrow animate-on-scroll">{{ section.settings.eyebrow }}</span>{%- endif -%}
        <h2 class="section-title h2 animate-on-scroll animate-on-scroll--delay-1">{{ section.settings.heading }}</h2>
      </div>
    {%- endif -%}
    <div style="display:grid;grid-template-columns:repeat({{ section.settings.columns }},1fr);gap:2rem;" data-stagger>
      {%- for block in section.blocks -%}
        {%- if block.type == 'column' -%}
          <div style="text-align:{{ section.settings.column_align }};" {{ block.shopify_attributes }}>
            {%- if block.settings.image != blank -%}
              <div style="margin-bottom:1.25rem;border-radius:var(--radius-lg);overflow:hidden;">
                {{ block.settings.image | image_url: width: 600 | image_tag: alt: block.settings.title, loading: 'lazy', width: 600, style: 'width:100%;aspect-ratio:1;object-fit:cover;' }}
              </div>
            {%- elsif block.settings.icon != blank -%}
              <div style="width:52px;height:52px;border-radius:var(--radius-lg);border:1px solid var(--color-border);display:flex;align-items:center;justify-content:center;margin-bottom:1rem;{% if section.settings.column_align == 'center' %}margin-left:auto;margin-right:auto;{% endif %}">
                <svg width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" aria-hidden="true">{{ block.settings.icon }}</svg>
              </div>
            {%- endif -%}
            {%- if block.settings.title != blank -%}<h3 style="font-size:1.125rem;font-weight:500;margin-bottom:0.5rem;">{{ block.settings.title }}</h3>{%- endif -%}
            {%- if block.settings.text != blank -%}<p style="font-size:0.9rem;color:var(--color-fg-muted);line-height:1.65;">{{ block.settings.text }}</p>{%- endif -%}
            {%- if block.settings.link_label != blank -%}<a href="{{ block.settings.link | default: '#' }}" style="display:inline-flex;align-items:center;gap:0.375rem;margin-top:0.75rem;font-size:0.875rem;font-weight:500;text-decoration:underline;text-underline-offset:2px;">{{ block.settings.link_label }}</a>{%- endif -%}
          </div>
        {%- endif -%}
      {%- endfor -%}
    </div>
  </div>
</section>

<style>
  @media (max-width:768px) { #mc-{{ section.id }} [style*="grid-template-columns:repeat"] { grid-template-columns: repeat(2,1fr) !important; } }
  @media (max-width:480px) { #mc-{{ section.id }} [style*="grid-template-columns:repeat"] { grid-template-columns: 1fr !important; } }
</style>

{% schema %}
{
  "name": "Multicolumn",
  "tag": "section",
  "settings": [
    { "type": "text", "id": "eyebrow", "label": "Eyebrow" },
    { "type": "text", "id": "heading", "label": "Heading" },
    { "type": "range", "id": "columns", "min": 2, "max": 4, "step": 1, "label": "Columns", "default": 3 },
    { "type": "select", "id": "column_align", "label": "Column alignment", "options": [{ "value": "left", "label": "Left" }, { "value": "center", "label": "Center" }], "default": "left" }
  ],
  "blocks": [
    {
      "type": "column",
      "name": "Column",
      "settings": [
        { "type": "image_picker", "id": "image", "label": "Image" },
        { "type": "text", "id": "icon", "label": "SVG icon path (advanced)", "info": "Paste SVG path data" },
        { "type": "text", "id": "title", "label": "Title", "default": "Feature title" },
        { "type": "textarea", "id": "text", "label": "Text", "default": "Describe this feature or benefit in a sentence or two." },
        { "type": "text", "id": "link_label", "label": "Link label" },
        { "type": "url", "id": "link", "label": "Link" }
      ]
    }
  ],
  "presets": [
    {
      "name": "Multicolumn",
      "blocks": [
        { "type": "column", "settings": { "title": "Quality Crafted", "text": "Every product is selected for durability, design, and everyday excellence." } },
        { "type": "column", "settings": { "title": "Fast Delivery", "text": "From our warehouse to your door in as little as 3–5 business days." } },
        { "type": "column", "settings": { "title": "Loved by Thousands", "text": "Join a growing community of customers who have made Xilveno their go-to store." } }
      ]
    }
  ]
}
{% endschema %}
