<div class="page-hero{% if section.settings.image %} page-hero--with-image{% endif %}{% unless section.settings.image %} section-padding{% endunless %}">
  {%- if section.settings.image != blank -%}
    {{ section.settings.image | image_url: width: 1800 | image_tag: class: 'page-hero__bg', alt: section.settings.heading, loading: 'eager', fetchpriority: 'high', width: 1800, height: 400 }}
    <div class="page-hero__overlay" aria-hidden="true"></div>
  {%- endif -%}
  <div class="page-hero__content page-container" style="{% if section.settings.image %}position:relative;z-index:2;{% endif %}">
    {%- if section.settings.eyebrow != blank -%}
      <p style="font-size:0.75rem;font-weight:500;text-transform:uppercase;letter-spacing:0.1em;{% if section.settings.image %}color:rgba(255,255,255,0.75);{% else %}color:var(--color-fg-muted);{% endif %}margin-bottom:0.5rem;">{{ section.settings.eyebrow }}</p>
    {%- endif -%}
    {%- if section.settings.heading != blank -%}
      <h1 class="h1" style="{% if section.settings.image %}color:#ffffff;{% endif %}">{{ section.settings.heading }}</h1>
    {%- endif -%}
    {%- if section.settings.subtext != blank -%}
      <p style="margin-top:0.75rem;font-size:1.0625rem;{% if section.settings.image %}color:rgba(255,255,255,0.8);{% else %}color:var(--color-fg-muted);{% endif %}max-width:540px;line-height:1.6;">{{ section.settings.subtext }}</p>
    {%- endif -%}
  </div>
</div>
{% schema %}
{
  "name": "Page hero",
  "tag": "section",
  "settings": [
    { "type": "image_picker", "id": "image", "label": "Background image (optional)" },
    { "type": "text", "id": "eyebrow", "label": "Eyebrow text" },
    { "type": "text", "id": "heading", "label": "Heading" },
    { "type": "text", "id": "subtext", "label": "Supporting text" }
  ],
  "presets": [{ "name": "Page hero" }]
}
{% endschema %}
