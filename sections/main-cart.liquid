<section class="cart-page"><div class="cart-page__intro"><span class="eyebrow">Your LumaForm edit</span><h1>Your cart</h1><a class="text-link" href="{{ routes.all_products_collection_url }}">Continue shopping <span>↗</span></a></div>{% if cart.item_count == 0 %}<div class="cart-page__empty"><span>◇</span><h2>Your cart is empty</h2><p>Discover a small upgrade for your daily ritual.</p><a class="button button--dark" href="{{ routes.all_products_collection_url }}">Explore tools</a></div>{% else %}<div class="cart-page__layout"><div class="cart-page__items"><div class="shipping-progress"><span>Free shipping unlocked at <strong>$75</strong></span><div><i style="width:{{ cart.total_price | divided_by: 75.0 | at_most: 100 }}%"></i></div><small>Add more to unlock your shipping benefit.</small></div>{% for item in cart.items %}<div class="cart-page-item"><div class="cart-page-item__image">{% if item.image %}{{ item.image | image_url: width: 360 | image_tag }}{% endif %}</div><div class="cart-page-item__details"><span class="eyebrow">{{ item.product.vendor | default: 'LumaForm' }}</span><h2>{{ item.product.title }}</h2><p>{{ item.final_line_price | money }}</p><div class="quantity-control"><button data-cart-change data-line="{{ forloop.index }}" data-quantity="{{ item.quantity | minus: 1 }}">−</button><span>{{ item.quantity }}</span><button data-cart-change data-line="{{ forloop.index }}" data-quantity="{{ item.quantity | plus: 1 }}">＋</button></div><a href="{{ item.url_to_remove }}" data-remove-item>Remove</a></div></div>{% endfor %}</div><aside class="cart-page__summary"><div class="gift-panel"><span class="gift-panel__mark">✦</span><div><strong>Complimentary gift</strong><p>Spend $75 or more and choose one tool with our compliments.</p><div class="gift-choices" data-gift-choices><button type="button" data-gift-choice="Contour cooling wand">Cooling wand</button><button type="button" data-gift-choice="Precision facial roller">Facial roller</button><button type="button" data-gift-choice="Travel tool set">Travel set</button></div><small data-gift-status>Choose one qualifying gift at checkout.</small></div></div><form class="discount-form" data-discount-form><input type="text" name="discount" placeholder="Discount code" aria-label="Discount code"><button type="submit">Apply</button></form><p class="cart-note" data-discount-note aria-live="polite"></p><div class="drawer-total"><span>Subtotal</span><strong>{{ cart.total_price | money }}</strong></div><a class="button button--accent button--full" href="{{ routes.checkout_url }}">Checkout <span>→</span></a><p class="payment-note">Taxes and shipping calculated at checkout<br>Visa · Mastercard · Amex · Shop Pay</p></aside></div><div class="cart-page__recommendations"><span class="eyebrow">You may also like</span><div><a href="{{ routes.all_products_collection_url }}">Facial tools</a><a href="{{ routes.all_products_collection_url }}">Beauty devices</a><a href="{{ routes.all_products_collection_url }}">Gift sets</a></div></div>{% endif %}</section>
{% schema %}{"name":"Main cart","settings":[],"presets":[{"name":"Main cart"}]}{% endschema %}