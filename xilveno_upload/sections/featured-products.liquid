{%- assign products_to_show = section.settings.products_to_show -%}
{%- assign collection = collections[section.settings.collection] -%}

<section class="section-padding" aria-labelledby="featured-products-{{ section.id }}">
  <div class="page-container">

    <div class="section-header{% if section.settings.heading_align == 'center' %} section-header--center{% endif %}">
      {%- if section.settings.eyebrow != blank -%}
        <span class="section-eyebrow animate-on-scroll">{{ section.settings.eyebrow }}</span>
      {%- endif -%}
      {%- if section.settings.heading != blank -%}
        <h2 class="section-title h2 animate-on-scroll animate-on-scroll--delay-1" id="featured-products-{{ section.id }}">
          {{ section.settings.heading }}
        </h2>
      {%- endif -%}
      {%- if section.settings.subheading != blank -%}
        <p class="section-subtitle animate-on-scroll animate-on-scroll--delay-2">{{ section.settings.subheading }}</p>
      {%- endif -%}
    </div>

    {%- if collection != blank and collection.products.size > 0 -%}
      <div class="products-grid products-grid--wide" data-stagger>
        {%- for product in collection.products limit: products_to_show -%}
          {%- render 'product-card', product: product -%}
        {%- endfor -%}
      </div>
    {%- elsif section.settings.show_placeholder -%}
      <div class="products-grid products-grid--wide">
        {%- for i in (1..4) -%}
          <div class="product-card">
            <div class="product-card__media" style="background:var(--color-surface);aspect-ratio:3/4;">
              {{ 'product-' | append: i | placeholder_svg_tag: 'placeholder-svg' }}
            </div>
            <div class="product-card__info">
              <p class="product-card__vendor">Xilveno</p>
              <p class="product-card__title">Sample Product {{ i }}</p>
              <div class="product-card__price-wrap">
                <span class="product-card__price">$29.00</span>
              </div>
            </div>
          </div>
        {%- endfor -%}
      </div>
    {%- endif -%}

    {%- if section.settings.show_view_all and collection != blank -%}
      <div class="section-cta" style="text-align:{{ section.settings.heading_align }};">
        <a href="{{ collection.url }}" class="btn btn--secondary animate-on-scroll">
          {{ section.settings.view_all_label | default: 'View all' }}
        </a>
      </div>
    {%- endif -%}

  </div>
</section>

{% schema %}
{
  "name": "Featured products",
  "tag": "section",
  "settings": [
    {
      "type": "collection",
      "id": "collection",
      "label": "Collection"
    },
    {
      "type": "range",
      "id": "products_to_show",
      "min": 2,
      "max": 8,
      "step": 1,
      "label": "Products to show",
      "default": 4
    },
    {
      "type": "select",
      "id": "heading_align",
      "label": "Heading alignment",
      "options": [
        { "value": "left", "label": "Left" },
        { "value": "center", "label": "Center" }
      ],
      "default": "left"
    },
    {
      "type": "text",
      "id": "eyebrow",
      "label": "Eyebrow text",
      "default": "Featured"
    },
    {
      "type": "text",
      "id": "heading",
      "label": "Heading",
      "default": "Best Sellers"
    },
    {
      "type": "text",
      "id": "subheading",
      "label": "Subheading"
    },
    {
      "type": "checkbox",
      "id": "show_view_all",
      "label": "Show 'View all' button",
      "default": true
    },
    {
      "type": "text",
      "id": "view_all_label",
      "label": "'View all' button label",
      "default": "View all"
    },
    {
      "type": "checkbox",
      "id": "show_placeholder",
      "label": "Show placeholder products in editor",
      "default": true
    }
  ],
  "presets": [
    {
      "name": "Featured products",
      "settings": {
        "heading": "Best Sellers",
        "eyebrow": "Most Loved"
      }
    }
  ]
}
{% endschema %}
