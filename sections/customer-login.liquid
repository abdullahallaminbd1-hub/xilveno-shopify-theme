<div class="page-container" style="display:flex;justify-content:center;padding:4rem var(--gutter);">
  <div style="width:100%;max-width:420px;">
    <div style="text-align:center;margin-bottom:2rem;">
      <h1 class="h2">{{ 'customer.login.title' | t | default: 'Sign in' }}</h1>
      <p style="color:var(--color-fg-muted);margin-top:0.5rem;font-size:0.9375rem;">Welcome back to Xilveno</p>
    </div>
    {%- form 'customer_login' -%}
      {%- if form.errors -%}
        <div role="alert" style="background:#fef2f2;border:1px solid #fca5a5;border-radius:var(--radius-lg);padding:0.875rem 1rem;margin-bottom:1.25rem;font-size:0.875rem;color:#991b1b;">
          {{ form.errors | default_errors }}
        </div>
      {%- endif -%}
      <div style="display:flex;flex-direction:column;gap:1rem;">
        <div class="field">
          <label class="field__label" for="login-email">Email</label>
          <input type="email" id="login-email" name="customer[email]" class="field__input" autocomplete="email" required>
        </div>
        <div class="field">
          <div style="display:flex;justify-content:space-between;align-items:center;margin-bottom:0.25rem;">
            <label class="field__label" for="login-password" style="margin-bottom:0;">Password</label>
            <a href="{{ routes.account_recover_url }}" style="font-size:0.8125rem;color:var(--color-fg-muted);">Forgot password?</a>
          </div>
          <input type="password" id="login-password" name="customer[password]" class="field__input" autocomplete="current-password" required>
        </div>
        <button type="submit" class="btn btn--primary btn--full btn--lg" style="margin-top:0.5rem;">Sign in</button>
      </div>
    {%- endform -%}
    <p style="text-align:center;margin-top:1.5rem;font-size:0.875rem;color:var(--color-fg-muted);">
      Don't have an account? <a href="{{ routes.account_register_url }}" style="font-weight:500;color:var(--color-fg);">Create one</a>
    </p>
  </div>
</div>
{% schema %}
{ "name": "Customer login", "tag": "section", "settings": [], "presets": [{ "name": "Customer login" }] }
{% endschema %}
