{%- comment -%}
  Hero height resolution: the section range overrides the theme-wide value.
  A value of 0 (or an unset section setting) falls back to Theme settings.
{%- endcomment -%}
{%- assign hero_height_desktop = settings.hero_height_desktop | default: 620 -%}
{%- assign hero_height_mobile = settings.hero_height_mobile | default: 480 -%}
{%- if section.settings.height_desktop > 0 -%}{%- assign hero_height_desktop = section.settings.height_desktop -%}{%- endif -%}
{%- if section.settings.height_mobile > 0 -%}{%- assign hero_height_mobile = section.settings.height_mobile -%}{%- endif -%}
<section class="lf-hero" data-slideshow data-autoplay="{{ section.settings.autoplay }}" style="--lf-hero-height:{{ hero_height_desktop }}px;--lf-hero-height-mobile:{{ hero_height_mobile }}px;">
  <div class="lf-hero__slides">
    {%- if section.blocks.size > 0 -%}
      {%- for block in section.blocks -%}
        <div class="lf-hero__slide{% if forloop.first %} is-active{% endif %}" data-slide {{ block.shopify_attributes }}
          {% if block.settings.image %}style="--slide-image: url({{ block.settings.image | image_url: width: 2200 }})"{% endif %}>
          <div class="lf-hero__media" aria-hidden="true">
            {%- if block.settings.image -%}
              {{ block.settings.image | image_url: width: 2200 | image_tag: loading: 'eager', class: 'lf-hero__image', alt: block.settings.heading }}
            {%- else -%}
              <div class="lf-hero__fallback lf-hero__fallback--{{ forloop.index }}"></div>
            {%- endif -%}
          </div>
          <div class="lf-hero__overlay" aria-hidden="true"></div>
          <div class="lf-hero__content">
            {%- if block.settings.kicker != blank -%}<span class="lf-eyebrow lf-eyebrow--light">{{ block.settings.kicker }}</span>{%- endif -%}
            {% if forloop.first %}<h1>{% else %}<h2>{% endif %}
              {{ block.settings.heading }}
            {% if forloop.first %}</h1>{% else %}</h2>{% endif %}
            {%- if block.settings.text != blank -%}<p>{{ block.settings.text }}</p>{%- endif -%}
            {%- if block.settings.button_label != blank -%}
              <a class="button button--accent" href="{{ block.settings.link | default: routes.all_products_collection_url }}">{{ block.settings.button_label }}</a>
            {%- endif -%}
          </div>
        </div>
      {%- endfor -%}
    {%- else -%}
      <div class="lf-hero__slide is-active">
        <div class="lf-hero__media" aria-hidden="true"><div class="lf-hero__fallback lf-hero__fallback--1"></div></div>
        <div class="lf-hero__overlay" aria-hidden="true"></div>
        <div class="lf-hero__content">
          <span class="lf-eyebrow lf-eyebrow--light">The LumaForm Edit</span>
          <h1>Elevate Your Everyday Beauty</h1>
          <p>Curated beauty tools and devices designed to bring confidence, simplicity and a refined touch to your everyday routine.</p>
          <a class="button button--accent" href="{{ routes.all_products_collection_url }}">Shop beauty tools</a>
        </div>
      </div>
    {%- endif -%}
  </div>
  {%- assign slide_count = section.blocks.size -%}
  {%- if slide_count > 1 -%}
    <div class="lf-hero__dots" role="tablist" aria-label="Slides">
      {%- for block in section.blocks -%}
        <button type="button" class="lf-hero__dot{% if forloop.first %} is-active{% endif %}" data-slide-dot="{{ forloop.index0 }}" aria-label="Go to slide {{ forloop.index }}" {{ block.shopify_attributes }}></button>
      {%- endfor -%}
    </div>
  {%- endif -%}
</section>

{% schema %}
{
  "name": "Hero slideshow",
  "settings": [
    {"type":"range","id":"autoplay","label":"Slide duration (seconds)","min":3,"max":10,"step":1,"unit":"s","default":6},
    {"type":"header","content":"Hero height"},
    {"type":"range","id":"height_desktop","label":"Desktop height override","info":"Set to 0 to use the theme-wide Desktop Hero Height setting.","min":0,"max":900,"step":10,"unit":"px","default":0},
    {"type":"range","id":"height_mobile","label":"Mobile height override","info":"Set to 0 to use the theme-wide Mobile Hero Height setting.","min":0,"max":760,"step":10,"unit":"px","default":0}
  ],
  "blocks": [
    {
      "type": "slide",
      "name": "Slide",
      "settings": [
        {"type":"text","id":"kicker","label":"Kicker","default":"The LumaForm Edit"},
        {"type":"text","id":"heading","label":"Heading","default":"Elevate Your Everyday Beauty"},
        {"type":"textarea","id":"text","label":"Text","default":"Curated beauty tools and devices designed to bring confidence, simplicity and a refined touch to your everyday routine."},
        {"type":"text","id":"button_label","label":"Button label","default":"Shop beauty tools"},
        {"type":"url","id":"link","label":"Button link"},
        {"type":"image_picker","id":"image","label":"Background image"}
      ]
    }
  ],
  "max_blocks": 6,
  "presets":[{"name":"Hero slideshow","blocks":[{"type":"slide"},{"type":"slide"},{"type":"slide"}]}]
}
{% endschema %}