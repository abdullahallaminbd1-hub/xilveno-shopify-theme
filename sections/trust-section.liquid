<section class="lf-confidence" data-reveal-group>
  <div class="page-width">
    <div class="lf-confidence__container">
      <div class="lf-confidence__left" data-reveal>
        <div class="lf-confidence__image">
          {%- if section.settings.image -%}
            {{ section.settings.image | image_url: width: 1200 | image_tag: loading: 'lazy', alt: section.settings.heading }}
          {%- else -%}
            <div class="lf-confidence__placeholder"></div>
          {%- endif -%}
        </div>
        <div class="lf-confidence__returns">
          <span class="lf-confidence__returns-icon">{% render 'icon', icon: 'return' %}</span>
          <div>
            <h4>30-Day Returns</h4>
            <p>Shop with added peace of mind. Eligible returns are handled according to our published returns policy.</p>
          </div>
        </div>
      </div>
      <div class="lf-confidence__right" data-reveal>
        <span class="lf-eyebrow">{{ section.settings.kicker }}</span>
        <h2 class="lf-section-title">{{ section.settings.heading }}</h2>
        <p class="lf-confidence__intro">{{ section.settings.text }}</p>
        <div class="lf-confidence__list">
          {%- for block in section.blocks -%}
            <div class="lf-confidence__item" {{ block.shopify_attributes }}>
              <span class="lf-confidence__icon">{{ block.settings.icon }}</span>
              <div><strong>{{ block.settings.title }}</strong><p>{{ block.settings.text }}</p></div>
            </div>
          {%- endfor -%}
        </div>
        <div class="lf-newsletter-box">
          <span class="lf-newsletter-box__eyebrow">{{ section.settings.newsletter_kicker }}</span>
          <h3>{{ section.settings.newsletter_heading }}</h3>
          <p>Sign up for product updates, curated finds and selected offers.</p>
          {% form 'customer', class: 'lf-newsletter-form' %}
            {%- if form.posted_successfully? -%}<p class="lf-newsletter-form__success">Thanks for subscribing.</p>{%- endif -%}
            <input type="hidden" name="contact[tags]" value="newsletter">
            <input type="email" name="contact[email]" placeholder="Enter your email address" aria-label="Email address" required>
            <button class="button button--accent" type="submit">Join the Edit</button>
          {% endform %}
          <small>By subscribing, you agree to receive marketing emails. You can unsubscribe at any time.</small>
        </div>
      </div>
    </div>
  </div>
</section>
{% schema %}
{
  "name": "Trust section",
  "settings": [
    {"type":"image_picker","id":"image","label":"Image"},
    {"type":"text","id":"kicker","label":"Kicker","default":"A more confident way to shop"},
    {"type":"text","id":"heading","label":"Heading","default":"Shop With <span>Confidence</span>"},
    {"type":"textarea","id":"text","label":"Text","default":"Thoughtfully selected products, clear delivery information and secure checkout support from browsing through to delivery."},
    {"type":"text","id":"newsletter_kicker","label":"Newsletter kicker","default":"Join the Xilveno Edit"},
    {"type":"text","id":"newsletter_heading","label":"Newsletter heading","default":"Beauty tools & new finds — delivered to your inbox."}
  ],
  "blocks": [
    {"type":"item","name":"Trust item","settings":[
      {"type":"text","id":"icon","label":"Icon (character)","default":"✓"},
      {"type":"text","id":"title","label":"Title","default":"Thoughtfully Selected"},
      {"type":"textarea","id":"text","label":"Text","default":"Beauty tools and everyday essentials chosen with care."}
    ]}
  ],
  "max_blocks": 6,
  "presets":[{"name":"Trust section","blocks":[
    {"type":"item","settings":{"icon":"✓","title":"Thoughtfully Selected","text":"Beauty tools and everyday essentials chosen with care."}},
    {"type":"item","settings":{"icon":"◇","title":"Secure Checkout","text":"A protected payment experience through trusted checkout methods."}},
    {"type":"item","settings":{"icon":"→","title":"Free US Shipping","text":"Clear shipping information and delivery details before purchase."}},
    {"type":"item","settings":{"icon":"✦","title":"Customer Support","text":"Helpful assistance when you need information about your order."}}
  ]}]
}
{% endschema %}