<article class="lf-product-card">
  <a class="lf-product-card__media" href="{{ product.url }}" aria-label="View {{ product.title | escape }}">
    {%- if product.featured_image -%}
      {{ product.featured_image | image_url: width: 800 | image_tag: loading: 'lazy', widths: '360,540,800', sizes: '(max-width: 750px) 50vw, 25vw', class: 'lf-product-card__image', alt: product.featured_image.alt | default: product.title }}
    {%- else -%}
      <div class="lf-product-card__placeholder">LF</div>
    {%- endif -%}
    {%- if badge != blank -%}<span class="lf-badge">{{ badge }}</span>
    {%- elsif product.compare_at_price > product.price -%}<span class="lf-badge">Sale</span>
    {%- endif -%}
    {%- if product.available == false -%}<span class="lf-badge lf-badge--sold">Sold out</span>{%- endif -%}
    {%- if arrow -%}<span class="lf-card-arrow" aria-hidden="true">↗</span>{%- endif -%}
  </a>
  <div class="lf-product-card__info">
    {%- if show_vendor -%}<span class="lf-product-card__vendor">{{ product.vendor | default: 'LumaForm' }}</span>{%- endif -%}
    <h3 class="lf-product-card__title"><a href="{{ product.url }}">{{ product.title }}</a></h3>
    {%- if show_note -%}<span class="lf-product-card__note">Thoughtfully selected</span>{%- endif -%}
    <div class="lf-product-card__price">
      <span>{{ product.price | money }}</span>
      {%- if product.compare_at_price > product.price -%}<s>{{ product.compare_at_price | money }}</s>{%- endif -%}
    </div>
    <div class="lf-product-card__actions">
      {%- comment -%}
        Quick add (homepage cards): resolve one safe, purchasable variant.
        Shopify picks the selected variant when it is available, otherwise the
        first available variant, otherwise nil (never an unavailable variant).
      {%- endcomment -%}
      {%- assign card_variant = product.selected_or_first_available_variant -%}
      {%- if card_variant and card_variant.available == false -%}{%- assign card_variant = nil -%}{%- endif -%}
      {%- assign card_label = button_label | default: 'Add to cart' -%}
      {%- if quick_add -%}
        {%- if card_variant -%}
          <button type="button" class="lf-card-btn lf-card-btn--{{ button_style | default: 'filled' }}" data-quick-add="{{ card_variant.id }}" data-quick-add-label="{{ card_label }}">{{ card_label }}</button>
        {%- else -%}
          <button type="button" class="lf-card-btn lf-card-btn--{{ button_style | default: 'filled' }}" disabled aria-disabled="true">Sold out</button>
        {%- endif -%}
      {%- elsif product.available and card_variant and product.variants.size == 1 and button_label == 'Add to cart' -%}
        <button type="button" class="lf-card-btn lf-card-btn--{{ button_style | default: 'filled' }}" data-quick-add="{{ card_variant.id }}" data-quick-add-label="{{ button_label }}">{{ button_label }}</button>
      {%- else -%}
        <a class="lf-card-btn lf-card-btn--{{ button_style | default: 'filled' }}" href="{{ product.url }}">{{ button_label | default: 'Choose options' }}</a>
      {%- endif -%}
      {%- unless hide_view_details -%}<a class="lf-card-view" href="{{ product.url }}">View details <span aria-hidden="true">→</span></a>{%- endunless -%}
    </div>
  </div>
</article>