{% comment %}rich-text.liquid{% endcomment %}
<section class="section-padding" id="rt-{{ section.id }}">
  <div class="page-container{% if section.settings.narrow %} page-container--narrow{% endif %}">
    <div class="animate-on-scroll" style="text-align:{{ section.settings.align }};">
      {%- if section.settings.eyebrow != blank -%}<span class="section-eyebrow">{{ section.settings.eyebrow }}</span>{%- endif -%}
      {%- if section.settings.heading != blank -%}<h2 class="h2" style="margin-top:0.75rem;">{{ section.settings.heading }}</h2>{%- endif -%}
      {%- if section.settings.text != blank -%}<div style="margin-top:1rem;font-size:1rem;line-height:1.7;color:var(--color-fg-muted);max-width:640px;{% if section.settings.align == 'center' %}margin-left:auto;margin-right:auto;{% endif %}">{{ section.settings.text }}</div>{%- endif -%}
      {%- if section.settings.btn_label != blank -%}<a href="{{ section.settings.btn_link | default: '#' }}" class="btn btn--primary" style="margin-top:1.5rem;">{{ section.settings.btn_label }}</a>{%- endif -%}
    </div>
  </div>
</section>

{% schema %}
{
  "name": "Rich text",
  "tag": "section",
  "settings": [
    { "type": "select", "id": "align", "label": "Alignment", "options": [{ "value": "left", "label": "Left" }, { "value": "center", "label": "Center" }], "default": "center" },
    { "type": "checkbox", "id": "narrow", "label": "Narrow container", "default": true },
    { "type": "text", "id": "eyebrow", "label": "Eyebrow" },
    { "type": "text", "id": "heading", "label": "Heading" },
    { "type": "richtext", "id": "text", "label": "Text" },
    { "type": "text", "id": "btn_label", "label": "Button label" },
    { "type": "url", "id": "btn_link", "label": "Button link" }
  ],
  "presets": [{ "name": "Rich text" }]
}
{% endschema %}
