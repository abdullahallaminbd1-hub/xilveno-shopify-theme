<div class="usp-strip">
  <div class="page-container">
    <div class="usp-strip__grid">
      {%- for block in section.blocks -%}
        {%- if block.type == 'usp' -%}
          <div class="usp-item" {{ block.shopify_attributes }}>
            <div class="usp-item__icon" aria-hidden="true">
              <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" width="20" height="20">
                {%- case block.settings.icon -%}
                  {%- when 'truck' -%}<rect x="1" y="3" width="15" height="13" rx="2"/><path d="M16 8h4l3 3v5h-7V8z"/><circle cx="5.5" cy="18.5" r="2.5"/><circle cx="18.5" cy="18.5" r="2.5"/>
                  {%- when 'shield' -%}<path d="M12 22s8-4 8-10V5l-8-3-8 3v7c0 6 8 10 8 10z" stroke-linecap="round" stroke-linejoin="round"/>
                  {%- when 'rotate' -%}<path d="M1 4v6h6M23 20v-6h-6" stroke-linecap="round" stroke-linejoin="round"/><path d="M20.49 9A9 9 0 0 0 5.64 5.64L1 10m22 4-4.64 4.36A9 9 0 0 1 3.51 15" stroke-linecap="round" stroke-linejoin="round"/>
                  {%- when 'star' -%}<polygon points="12 2 15.09 8.26 22 9.27 17 14.14 18.18 21.02 12 17.77 5.82 21.02 7 14.14 2 9.27 8.91 8.26 12 2"/>
                  {%- when 'tag' -%}<path d="M20.59 13.41l-7.17 7.17a2 2 0 0 1-2.83 0L2 12V2h10l8.59 8.59a2 2 0 0 1 0 2.82z"/><line x1="7" y1="7" x2="7.01" y2="7"/>
                  {%- else -%}<path d="M22 11.08V12a10 10 0 1 1-5.93-9.14" stroke-linecap="round" stroke-linejoin="round"/><polyline points="22 4 12 14.01 9 11.01"/>
                {%- endcase -%}
              </svg>
            </div>
            <div class="usp-item__content">
              <p class="usp-item__title">{{ block.settings.title }}</p>
              {%- if block.settings.desc != blank -%}<p class="usp-item__desc">{{ block.settings.desc }}</p>{%- endif -%}
            </div>
          </div>
        {%- endif -%}
      {%- endfor -%}
    </div>
  </div>
</div>

{% schema %}
{
  "name": "USP strip",
  "tag": "section",
  "blocks": [
    {
      "type": "usp",
      "name": "USP item",
      "settings": [
        { "type": "select", "id": "icon", "label": "Icon", "options": [{ "value": "truck", "label": "Shipping" }, { "value": "shield", "label": "Security" }, { "value": "rotate", "label": "Returns" }, { "value": "star", "label": "Quality" }, { "value": "tag", "label": "Price" }, { "value": "check", "label": "Checkmark" }], "default": "truck" },
        { "type": "text", "id": "title", "label": "Title", "default": "Free Shipping" },
        { "type": "text", "id": "desc", "label": "Description", "default": "On all orders over $50" }
      ]
    }
  ],
  "presets": [
    {
      "name": "USP strip",
      "blocks": [
        { "type": "usp", "settings": { "icon": "truck", "title": "Free Shipping", "desc": "On orders over $50" } },
        { "type": "usp", "settings": { "icon": "rotate", "title": "30-Day Returns", "desc": "Hassle-free returns" } },
        { "type": "usp", "settings": { "icon": "shield", "title": "Secure Checkout", "desc": "SSL encrypted payments" } },
        { "type": "usp", "settings": { "icon": "star", "title": "Premium Quality", "desc": "Curated for everyday life" } }
      ]
    }
  ]
}
{% endschema %}
