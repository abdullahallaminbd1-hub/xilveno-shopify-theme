{%- comment -%}
  Wishlist initializer — sets up wishlist button states on page load.
  Rendered once in theme.liquid before closing body.
  The heavy lifting is in component-wishlist.js.
{%- endcomment -%}
<script>
// Expose current product ID to wishlist component if on a product page
{%- if template.name == 'product' -%}
window.__xilveno_product_id = {{ product.id | json }};
{%- endif -%}
</script>
