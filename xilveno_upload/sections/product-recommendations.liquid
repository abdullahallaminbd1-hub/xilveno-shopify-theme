<section class="section-padding" id="product-recommendations-{{ section.id }}" data-product-id="{{ product.id }}" data-section-id="{{ section.id }}" data-limit="{{ section.settings.limit }}">
  <div class="page-container">
    <div class="section-header">
      <h2 class="section-title h3">{{ section.settings.heading | default: 'You may also like' }}</h2>
    </div>
    <div class="products-grid products-grid--wide" id="recommendations-grid-{{ section.id }}" aria-live="polite" aria-label="Product recommendations"></div>
  </div>
</section>

<script>
(function() {
  var section = document.getElementById('product-recommendations-{{ section.id }}');
  if (!section) return;

  var productId = section.dataset.productId;
  var limit = section.dataset.limit || 4;
  var grid = document.getElementById('recommendations-grid-{{ section.id }}');

  if (!productId || !grid) return;

  fetch('/recommendations/products.json?product_id=' + productId + '&limit=' + limit + '&intent=related')
    .then(function(r) { return r.json(); })
    .then(function(data) {
      if (!data.products || !data.products.length) { section.style.display = 'none'; return; }
      grid.innerHTML = data.products.map(function(p) {
        var price = p.price ? ('$' + (p.price / 100).toFixed(2)) : '';
        var comparePrice = p.compare_at_price && p.compare_at_price > p.price ? ('$' + (p.compare_at_price / 100).toFixed(2)) : null;
        var img = p.featured_image ? '<img src="' + p.featured_image + '&width=400" alt="' + (p.title || '').replace(/"/g, '&quot;') + '" loading="lazy" width="400" height="533" style="width:100%;height:100%;object-fit:cover;">' : '';
        var onSale = comparePrice ? ' product-card__price--sale' : '';
        return '<article class="product-card">' +
          '<div class="product-card__media" style="aspect-ratio:3/4;background:var(--color-surface);overflow:hidden;border-radius:var(--radius-lg);">' +
            '<a href="' + p.url + '" aria-label="' + (p.title || '').replace(/"/g, '&quot;') + '">' + img + '</a>' +
          '</div>' +
          '<div class="product-card__info">' +
            (p.vendor ? '<p class="product-card__vendor">' + p.vendor + '</p>' : '') +
            '<a href="' + p.url + '" class="product-card__title">' + (p.title || '') + '</a>' +
            '<div class="product-card__price-wrap">' +
              '<span class="product-card__price' + onSale + '">' + price + '</span>' +
              (comparePrice ? '<span class="product-card__price product-card__price--compare"><s>' + comparePrice + '</s></span>' : '') +
            '</div>' +
          '</div>' +
        '</article>';
      }).join('');
    })
    .catch(function() { section.style.display = 'none'; });
})();
</script>

{% schema %}
{
  "name": "Product recommendations",
  "tag": "section",
  "settings": [
    { "type": "text", "id": "heading", "label": "Heading", "default": "You may also like" },
    { "type": "range", "id": "limit", "min": 2, "max": 6, "step": 1, "label": "Number of products", "default": 4 }
  ],
  "presets": [{ "name": "Product recommendations" }]
}
{% endschema %}
