<section class="product-page"><div class="product-main-media">{% if product.featured_image %}{{ product.featured_image | image_url: width: 1200 | image_tag: class: 'product-main-image' }}{% else %}<div class="product-placeholder large">LumaForm</div>{% endif %}</div><div class="product-details"><span class="eyebrow">{{ product.vendor | default: 'LumaForm' }}</span><h1>{{ product.title }}</h1><div class="price-large">{{ product.price | money }}</div><div class="rte">{{ product.description }}</div>{% form 'product', product %}{% unless product.has_only_default_variant %}<select name="id">{% for variant in product.variants %}<option value="{{ variant.id }}">{{ variant.title }} — {{ variant.price | money }}</option>{% endfor %}</select>{% else %}<input type="hidden" name="id" value="{{ product.selected_or_first_available_variant.id }}">{% endunless %}<button class="button accent full" type="submit">Add to cart →</button>{% endform %}<p class="promise">◇ Free US shipping over $75<br>↺ 30-day returns on eligible items</p></div></section><section class="product-reassurance"><span>Secure checkout</span><span>Clear delivery</span><span>Customer support</span></section>{% schema %}{"name":"Product information","settings":[],"presets":[{"name":"Product information"}]}{% endschema %}