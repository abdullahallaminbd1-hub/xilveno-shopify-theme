{%- assign product = product -%}
{%- assign first_variant = product.selected_or_first_available_variant -%}
{%- assign on_sale = false -%}
{%- if product.compare_at_price > product.price -%}{%- assign on_sale = true -%}{%- endif -%}

{%- comment -%} Product JSON for JS variant switching {%- endcomment -%}
<script type="application/json" data-product-json>
  {{ product | json }}
</script>

<div class="page-container">
  <nav class="breadcrumb" aria-label="{{ 'general.breadcrumb.label' | t | default: 'Breadcrumb' }}" style="padding:1rem 0;font-size:0.8125rem;color:var(--color-fg-muted);display:flex;gap:0.5rem;align-items:center;">
    <a href="{{ routes.root_url }}" style="color:inherit;">{{ 'general.breadcrumb.home' | t | default: 'Home' }}</a>
    <span aria-hidden="true">/</span>
    {%- if product.collections.first -%}
      <a href="{{ product.collections.first.url }}" style="color:inherit;">{{ product.collections.first.title }}</a>
      <span aria-hidden="true">/</span>
    {%- endif -%}
    <span aria-current="page" style="color:var(--color-fg);">{{ product.title }}</span>
  </nav>

  <div class="product-page">

    {%- comment -%} ─── Gallery ─────────────────────────────────────────────── {%- endcomment -%}
    <div class="product-gallery" id="product-gallery">
      <div class="product-gallery__main" aria-label="{{ 'products.product.media.gallery_viewer' | t | default: 'Product images' }}">
        {%- if product.featured_image != blank -%}
          {{ product.featured_image
            | image_url: width: 1200
            | image_tag:
              class: 'product-gallery__main-image',
              alt: product.featured_image.alt,
              loading: 'eager',
              fetchpriority: 'high',
              width: 1200,
              height: 1200,
              id: 'product-main-image'
          }}
        {%- else -%}
          {{ 'product-1' | placeholder_svg_tag: 'product-gallery__main-image placeholder-svg' }}
        {%- endif -%}
      </div>

      {%- if product.images.size > 1 -%}
        <div class="product-gallery__thumbnails" role="list" aria-label="{{ 'products.product.media.thumbnails' | t | default: 'Product thumbnails' }}">
          {%- for image in product.images limit: 6 -%}
            <button
              class="product-gallery__thumb{% if forloop.first %} is-active{% endif %}"
              data-src="{{ image | image_url: width: 1200 }}"
              data-srcset="{{ image | image_url: width: 600 }} 600w, {{ image | image_url: width: 1200 }} 1200w"
              data-alt="{{ image.alt | escape }}"
              role="listitem"
              aria-label="{{ 'products.product.media.load_image' | t: index: forloop.index | default: 'View image ' | append: forloop.index }}"
              aria-pressed="{{ forloop.first }}"
            >
              {{ image | image_url: width: 120 | image_tag: alt: image.alt, loading: 'lazy', width: 120, height: 120 }}
            </button>
          {%- endfor -%}
        </div>
      {%- endif -%}
    </div>

    {%- comment -%} ─── Product Info ─────────────────────────────────────────── {%- endcomment -%}
    <div class="product-info" id="product-info">

      {%- if product.vendor != blank -%}
        <p class="product-info__vendor">{{ product.vendor }}</p>
      {%- endif -%}

      <h1 class="product-info__title">{{ product.title }}</h1>

      {%- comment -%} Price {%- endcomment -%}
      <div class="product-info__price-wrap" aria-label="{{ 'products.product.price.regular_price' | t | default: 'Price' }}">
        <span class="product-info__price{% if on_sale %} product-info__price--sale{% endif %}">
          {{ first_variant.price | money }}
        </span>
        {%- if on_sale -%}
          <span class="product-info__price product-info__price--compare" aria-label="{{ 'products.product.price.regular_price' | t | default: 'Regular price' }}">
            <s>{{ first_variant.compare_at_price | money }}</s>
          </span>
          {%- assign saving = first_variant.compare_at_price | minus: first_variant.price | times: 100 | divided_by: first_variant.compare_at_price -%}
          <span class="product-info__saving" aria-label="{{ 'products.product.price.save' | t | default: 'Save' }} {{ saving }}%">Save {{ saving }}%</span>
        {%- endif -%}
      </div>

      {%- comment -%} Reviews app block slot {%- endcomment -%}
      <div class="product-reviews-slot" aria-label="Product reviews" style="min-height:24px;">
        {%- comment -%}
          App block slot for product reviews.
          Connect Judge.me, Okendo, Yotpo, or Shopify Product Reviews in Theme Editor → App embeds.
          When an app is connected it populates this area with real review data.
        {%- endcomment -%}
        {{ section.blocks | where: 'type', '@app' | map: 'content' | join: '' }}
      </div>

      <hr class="product-info__divider">

      {%- comment -%} Variants {%- endcomment -%}
      <form method="post" action="{{ routes.cart_add_url }}" data-product-form novalidate>
        <input type="hidden" name="form_type" value="product">
        <input type="hidden" name="utf8" value="✓">
        <input type="hidden" name="id" value="{{ first_variant.id }}">

        {%- unless product.has_only_default_variant -%}
          {%- for option in product.options_with_values -%}
            <div class="product-option">
              <label class="product-option__label" for="option-{{ forloop.index0 }}-{{ section.id }}">
                {{ option.name }}: <span>{{ option.selected_value }}</span>
              </label>
              <div class="product-option__swatches" role="group" aria-label="{{ option.name }}">
                {%- for value in option.values -%}
                  {%- assign swatch_available = false -%}
                  {%- for variant in product.variants -%}
                    {%- if variant.option1 == value or variant.option2 == value or variant.option3 == value -%}
                      {%- if variant.available -%}{%- assign swatch_available = true -%}{%- endif -%}
                    {%- endif -%}
                  {%- endfor -%}
                  <button
                    type="button"
                    class="swatch{% if option.selected_value == value %} is-active{% endif %}{% unless swatch_available %} is-unavailable{% endunless %}"
                    data-value="{{ value | escape }}"
                    data-option="{{ option.name | escape }}"
                    data-option-index="{{ forloop.parentloop.index0 }}"
                    aria-label="{{ option.name }}: {{ value }}"
                    {% if option.selected_value == value %}aria-pressed="true"{% else %}aria-pressed="false"{% endif %}
                    {% unless swatch_available %}aria-disabled="true"{% endunless %}
                  >
                    {{ value }}
                  </button>
                {%- endfor -%}
              </div>

              {%- comment -%} Hidden select for form submission {%- endcomment -%}
              <select
                name="options[{{ option.name | escape }}]"
                id="option-{{ forloop.index0 }}-{{ section.id }}"
                data-option-index="{{ forloop.index0 }}"
                class="visually-hidden"
                aria-label="{{ option.name }}"
              >
                {%- for value in option.values -%}
                  <option value="{{ value | escape }}"{% if option.selected_value == value %} selected{% endif %}>
                    {{ value }}
                  </option>
                {%- endfor -%}
              </select>
            </div>
          {%- endfor -%}
        {%- endunless -%}

        {%- comment -%} Stock indicator — uses real Shopify inventory data {%- endcomment -%}
        {%- if first_variant.inventory_management and first_variant.inventory_policy == 'deny' -%}
          <div class="product-info__stock" aria-live="polite">
            {%- if first_variant.available -%}
              {%- if first_variant.inventory_quantity > 0 and first_variant.inventory_quantity <= 10 -%}
                <span class="stock-dot stock-dot--low" aria-hidden="true"></span>
                <span data-stock-text>Only {{ first_variant.inventory_quantity }} left in stock</span>
              {%- else -%}
                <span class="stock-dot stock-dot--in" aria-hidden="true"></span>
                <span data-stock-text>In stock</span>
              {%- endif -%}
            {%- else -%}
              <span class="stock-dot stock-dot--out" aria-hidden="true"></span>
              <span data-stock-text>Out of stock</span>
            {%- endif -%}
          </div>
        {%- endif -%}

        {%- comment -%} Quantity & ATC {%- endcomment -%}
        <div class="product-atc-wrap">
          {%- if section.settings.show_quantity -%}
            <div class="product-quantity" data-quantity-wrap aria-label="{{ 'products.product.quantity.label' | t | default: 'Quantity' }}">
              <button type="button" class="product-quantity__btn" data-qty-dec aria-label="{{ 'products.product.quantity.decrease' | t | default: 'Decrease quantity' }}">
                <svg width="14" height="14" viewBox="0 0 14 14" fill="currentColor" aria-hidden="true"><rect x="2" y="6.5" width="10" height="1" rx="0.5"/></svg>
              </button>
              <input
                type="number"
                name="quantity"
                value="1"
                min="1"
                class="product-quantity__input"
                aria-label="{{ 'products.product.quantity.input_label' | t | default: 'Quantity' }}"
              >
              <button type="button" class="product-quantity__btn" data-qty-inc aria-label="{{ 'products.product.quantity.increase' | t | default: 'Increase quantity' }}">
                <svg width="14" height="14" viewBox="0 0 14 14" fill="currentColor" aria-hidden="true"><path d="M7.5 2a.5.5 0 0 0-1 0v4.5H2a.5.5 0 0 0 0 1h4.5V12a.5.5 0 0 0 1 0V7.5H12a.5.5 0 0 0 0-1H7.5V2z"/></svg>
              </button>
            </div>
          {%- endif -%}

          <button
            type="submit"
            class="btn btn--primary btn--full btn--lg product-atc-btn"
            data-atc-btn
            {% unless first_variant.available %}disabled{% endunless %}
            aria-label="{{ 'products.product.add_to_cart' | t | default: 'Add to cart' }}"
          >
            <span class="btn__text">
              {%- if first_variant.available -%}
                {{ 'products.product.add_to_cart' | t | default: 'Add to cart' }}
              {%- else -%}
                {{ 'products.product.sold_out' | t | default: 'Sold out' }}
              {%- endif -%}
            </span>
            <div class="product-atc-loading">
              <div class="spinner" aria-hidden="true"></div>
            </div>
          </button>
          <p data-atc-error class="field__error" style="display:none;"></p>
        </div>
      </form>

      {%- comment -%} Wishlist {%- endcomment -%}
      <button
        class="btn btn--ghost btn--full"
        data-wishlist-btn="{{ product.id }}"
        data-wishlist-title="{{ product.title | escape }}"
        data-wishlist-url="{{ product.url }}"
        data-wishlist-price="{{ product.price }}"
        data-wishlist-image="{{ product.featured_image | image_url: width: 400 }}"
        data-wishlist-vendor="{{ product.vendor | escape }}"
        style="gap:0.5rem;"
        aria-label="Save to wishlist"
      >
        <svg width="18" height="18" viewBox="0 0 18 18" fill="none" aria-hidden="true" data-wishlist-icon>
          <path d="M15.65 3.35a5.5 5.5 0 0 0-7.78 0L7 4.22l-.87-.87a5.5 5.5 0 0 0-7.78 7.78l.87.87L7 18.78l7.78-7.78.87-.87a5.5 5.5 0 0 0 0-7.78z" stroke="currentColor" stroke-width="1.3" stroke-linejoin="round"/>
        </svg>
        <span>Save to wishlist</span>
      </button>

      <hr class="product-info__divider">

      {%- comment -%} Trust strip {%- endcomment -%}
      <div class="product-trust" aria-label="Purchase assurances">
        {%- for block in section.blocks -%}
          {%- if block.type == 'trust_item' -%}
            <div class="product-trust__item" {{ block.shopify_attributes }}>
              <svg class="product-trust__icon" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" aria-hidden="true">
                {%- case block.settings.icon -%}
                  {%- when 'shield' -%}
                    <path d="M12 22s8-4 8-10V5l-8-3-8 3v7c0 6 8 10 8 10z" stroke-linecap="round" stroke-linejoin="round"/>
                  {%- when 'truck' -%}
                    <rect x="1" y="3" width="15" height="13" rx="2"/><path d="M16 8h4l3 3v5h-7V8z"/><circle cx="5.5" cy="18.5" r="2.5"/><circle cx="18.5" cy="18.5" r="2.5"/>
                  {%- when 'rotate' -%}
                    <path d="M1 4v6h6M23 20v-6h-6" stroke-linecap="round" stroke-linejoin="round"/><path d="M20.49 9A9 9 0 0 0 5.64 5.64L1 10m22 4-4.64 4.36A9 9 0 0 1 3.51 15" stroke-linecap="round" stroke-linejoin="round"/>
                  {%- else -%}
                    <path d="M22 11.08V12a10 10 0 1 1-5.93-9.14" stroke-linecap="round" stroke-linejoin="round"/><polyline points="22 4 12 14.01 9 11.01"/>
                {%- endcase -%}
              </svg>
              <span class="product-trust__label">{{ block.settings.label }}</span>
            </div>
          {%- endif -%}
        {%- endfor -%}
      </div>

      {%- comment -%} Short description {%- endcomment -%}
      {%- if section.settings.show_short_description and product.metafields.custom.short_description != blank -%}
        <div class="product-short-desc" style="font-size:0.875rem;color:var(--color-fg-muted);line-height:1.625;">
          {{ product.metafields.custom.short_description | metafield_tag }}
        </div>
      {%- endif -%}

    </div>
  </div>
</div>

{%- comment -%} ─── Product Tabs ──────────────────────────────────────────────── {%- endcomment -%}
{%- if section.settings.show_tabs -%}
<div class="page-container" style="margin-top:3rem;">
  <div class="product-tabs" data-tabs>
    <div class="tabs__nav" role="tablist" aria-label="{{ 'products.product.tabs.label' | t | default: 'Product details' }}">
      {%- if product.description != blank -%}
        <button class="tabs__btn is-active" role="tab" aria-selected="true" aria-controls="tab-description-{{ section.id }}" id="tab-btn-desc-{{ section.id }}">
          {{ 'products.product.description' | t | default: 'Description' }}
        </button>
      {%- endif -%}
      {%- for block in section.blocks -%}
        {%- if block.type == 'tab' -%}
          <button class="tabs__btn{% if product.description == blank and forloop.first %} is-active{% endif %}" role="tab" aria-selected="{% if product.description == blank and forloop.first %}true{% else %}false{% endif %}" aria-controls="tab-{{ block.id }}" {{ block.shopify_attributes }}>
            {{ block.settings.title }}
          </button>
        {%- endif -%}
      {%- endfor -%}
    </div>
    {%- if product.description != blank -%}
      <div class="tabs__panel is-active" id="tab-description-{{ section.id }}" role="tabpanel" aria-labelledby="tab-btn-desc-{{ section.id }}">
        <div class="rte" style="font-size:0.875rem;line-height:1.7;color:var(--color-fg-muted);">
          {{ product.description }}
        </div>
      </div>
    {%- endif -%}
    {%- for block in section.blocks -%}
      {%- if block.type == 'tab' -%}
        <div class="tabs__panel{% if product.description == blank and forloop.first %} is-active{% endif %}" id="tab-{{ block.id }}" role="tabpanel" {{ block.shopify_attributes }}>
          <div style="font-size:0.875rem;line-height:1.7;color:var(--color-fg-muted);">
            {{ block.settings.content }}
          </div>
        </div>
      {%- endif -%}
    {%- endfor -%}
  </div>
</div>
{%- endif -%}

{%- comment -%} ─── Sticky ATC ───────────────────────────────────────────────── {%- endcomment -%}
{%- if section.settings.show_sticky_atc -%}
<div class="sticky-atc" id="sticky-atc" aria-label="{{ 'products.product.add_to_cart' | t | default: 'Add to cart' }}" aria-hidden="true">
  <div class="sticky-atc__inner">
    <div class="sticky-atc__info">
      {%- if product.featured_image != blank -%}
        <div class="sticky-atc__thumb">
          {{ product.featured_image | image_url: width: 96 | image_tag: alt: product.title, loading: 'lazy', width: 48, height: 48 }}
        </div>
      {%- endif -%}
      <div>
        <p class="sticky-atc__title">{{ product.title }}</p>
        <p class="sticky-atc__price">{{ product.price | money }}</p>
      </div>
    </div>
    <button
      class="btn btn--primary sticky-atc__btn"
      {% unless first_variant.available %}disabled{% endunless %}
      aria-label="{{ 'products.product.add_to_cart' | t | default: 'Add to cart' }}"
    >
      {%- if first_variant.available -%}
        {{ 'products.product.add_to_cart' | t | default: 'Add to cart' }}
      {%- else -%}
        {{ 'products.product.sold_out' | t | default: 'Sold out' }}
      {%- endif -%}
    </button>
  </div>
</div>
{%- endif -%}

{% schema %}
{
  "name": "Product information",
  "tag": "section",
  "settings": [
    {
      "type": "checkbox",
      "id": "show_quantity",
      "label": "Show quantity selector",
      "default": true
    },
    {
      "type": "checkbox",
      "id": "show_short_description",
      "label": "Show short description (from metafield custom.short_description)",
      "default": false
    },
    {
      "type": "checkbox",
      "id": "show_tabs",
      "label": "Show product tabs",
      "default": true
    },
    {
      "type": "checkbox",
      "id": "show_sticky_atc",
      "label": "Show sticky add-to-cart bar",
      "default": true
    }
  ],
  "blocks": [
    {
      "type": "@app"
    },
    {
      "type": "trust_item",
      "name": "Trust item",
      "settings": [
        {
          "type": "select",
          "id": "icon",
          "label": "Icon",
          "options": [
            { "value": "shield", "label": "Shield (Secure)" },
            { "value": "truck", "label": "Truck (Shipping)" },
            { "value": "rotate", "label": "Rotate (Returns)" },
            { "value": "check", "label": "Check (Guarantee)" }
          ],
          "default": "shield"
        },
        {
          "type": "text",
          "id": "label",
          "label": "Label",
          "default": "Secure checkout"
        }
      ]
    },
    {
      "type": "tab",
      "name": "Product tab",
      "settings": [
        {
          "type": "text",
          "id": "title",
          "label": "Tab title",
          "default": "Shipping & Returns"
        },
        {
          "type": "richtext",
          "id": "content",
          "label": "Tab content",
          "default": "<p>We offer free standard shipping on orders over $50. Orders typically arrive within 5–10 business days. 30-day returns accepted for unworn, undamaged items.</p>"
        }
      ]
    }
  ],
  "presets": [
    {
      "name": "Product information",
      "blocks": [
        { "type": "trust_item", "settings": { "icon": "truck", "label": "Free shipping over $50" } },
        { "type": "trust_item", "settings": { "icon": "rotate", "label": "30-day returns" } },
        { "type": "trust_item", "settings": { "icon": "shield", "label": "Secure checkout" } },
        { "type": "tab", "settings": { "title": "Shipping & Returns" } }
      ]
    }
  ]
}
{% endschema %}
