<section class="cart-page"><div class="page-intro"><span class="eyebrow">Your LumaForm edit</span><h1>Your cart</h1><a class="text-link" href="{{ routes.all_products_collection_url }}">Continue shopping ↗</a></div>{% if cart.item_count == 0 %}<div class="empty-state page-empty"><span>◇</span><h2>Your cart is empty</h2><p>Discover a small upgrade for your daily ritual.</p><a class="button dark" href="{{ routes.all_products_collection_url }}">Explore tools</a></div>{% else %}<div class="cart-layout"><div>{% for item in cart.items %}<div class="cart-page-item">{% if item.image %}{{ item.image | image_url: width: 360 | image_tag }}{% endif %}<div><span class="eyebrow">{{ item.product.vendor }}</span><h2>{{ item.product.title }}</h2><p>{{ item.final_line_price | money }}</p><button data-cart-change data-line="{{ forloop.index }}" data-quantity="{{ item.quantity | minus: 1 }}">−</button> {{ item.quantity }} <button data-cart-change data-line="{{ forloop.index }}" data-quantity="{{ item.quantity | plus: 1 }}">＋</button><a href="{{ item.url_to_remove }}" data-remove-item>Remove</a></div></div>{% endfor %}</div><aside class="cart-summary"><div class="gift-panel"><b>✦ Complimentary gift</b><p>Spend $75 or more and choose one tool.</p><button data-gift-choice="Cooling wand">Choose gift</button></div><div class="drawer-total"><span>Subtotal</span><b>{{ cart.total_price | money }}</b></div><a class="button accent full" href="{{ routes.checkout_url }}">Checkout →</a></aside></div>{% endif %}</section>{% schema %}{"name":"Cart page","settings":[],"presets":[{"name":"Cart page"}]}{% endschema %}