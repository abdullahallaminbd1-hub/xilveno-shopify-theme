<div class="page-container" style="display:flex;justify-content:center;padding:4rem var(--gutter);">
  <div style="width:100%;max-width:420px;">
    <div style="text-align:center;margin-bottom:2rem;">
      <h1 class="h2">Create account</h1>
      <p style="color:var(--color-fg-muted);margin-top:0.5rem;font-size:0.9375rem;">Join Xilveno today</p>
    </div>
    {%- form 'create_customer' -%}
      {%- if form.errors -%}
        <div role="alert" style="background:#fef2f2;border:1px solid #fca5a5;border-radius:var(--radius-lg);padding:0.875rem 1rem;margin-bottom:1.25rem;font-size:0.875rem;color:#991b1b;">
          {{ form.errors | default_errors }}
        </div>
      {%- endif -%}
      <div style="display:flex;flex-direction:column;gap:1rem;">
        <div style="display:grid;grid-template-columns:1fr 1fr;gap:1rem;">
          <div class="field">
            <label class="field__label" for="reg-first">First name</label>
            <input type="text" id="reg-first" name="customer[first_name]" class="field__input" autocomplete="given-name">
          </div>
          <div class="field">
            <label class="field__label" for="reg-last">Last name</label>
            <input type="text" id="reg-last" name="customer[last_name]" class="field__input" autocomplete="family-name">
          </div>
        </div>
        <div class="field">
          <label class="field__label" for="reg-email">Email</label>
          <input type="email" id="reg-email" name="customer[email]" class="field__input" autocomplete="email" required>
        </div>
        <div class="field">
          <label class="field__label" for="reg-password">Password</label>
          <input type="password" id="reg-password" name="customer[password]" class="field__input" autocomplete="new-password" required minlength="5">
        </div>
        <button type="submit" class="btn btn--primary btn--full btn--lg" style="margin-top:0.5rem;">Create account</button>
      </div>
    {%- endform -%}
    <p style="text-align:center;margin-top:1.5rem;font-size:0.875rem;color:var(--color-fg-muted);">
      Already have an account? <a href="{{ routes.account_login_url }}" style="font-weight:500;color:var(--color-fg);">Sign in</a>
    </p>
  </div>
</div>
{% schema %}
{ "name": "Customer register", "tag": "section", "settings": [], "presets": [{ "name": "Customer register" }] }
{% endschema %}
