<section class="product-section"><div class="section-heading"><div><span class="eyebrow">{{ section.settings.kicker }}</span><h2>{{ section.settings.heading }}</h2></div><a class="text-link" href="{{ routes.all_products_collection_url }}">Shop all <span>↗</span></a></div><div class="product-grid product-grid--{{ section.settings.columns }}">{% assign collection = collections[section.settings.collection] %}{% if collection.products.size > 0 %}{% for product in collection.products limit: 4 %}{% render 'product-card', product: product %}{% endfor %}{% else %}{% for i in (1..4) %}<article class="product-card"><div class="product-card__media product-placeholder product-placeholder--{{ i }}"><div>{{ i }}</div><span class="quick-add">Quick add <span>+</span></span></div><div class="product-card__info"><div class="eyebrow">LumaForm / Tool {{ i }}</div><h3>{% case i %}{% when 1 %}Contour cooling wand{% when 2 %}Sculpting facial roller{% when 3 %}Precision brow trimmer{% else %}Heatless styling set{% endcase %}</h3><div class="price">${{ i | plus: 17 }}.00</div></div></article>{% endfor %}{% endif %}</div></section>
{% schema %}{"name":"Featured products","settings":[{"type":"text","id":"kicker","label":"Kicker","default":"The LumaForm edit"},{"type":"text","id":"heading","label":"Heading","default":"Tools worth making room for."},{"type":"collection","id":"collection","label":"Collection"},{"type":"url","id":"link","label":"View all link"}],"presets":[{"name":"Featured products"}]}{% endschema %}