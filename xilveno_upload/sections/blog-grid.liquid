<section class="section-padding" id="blog-{{ section.id }}">
  <div class="page-container">
    <div class="section-header{% if section.settings.align == 'center' %} section-header--center{% endif %}">
      {%- if section.settings.eyebrow != blank -%}<span class="section-eyebrow animate-on-scroll">{{ section.settings.eyebrow }}</span>{%- endif -%}
      {%- if section.settings.heading != blank -%}<h2 class="section-title h2 animate-on-scroll animate-on-scroll--delay-1">{{ section.settings.heading }}</h2>{%- endif -%}
    </div>
    {%- assign blog_handle = section.settings.blog -%}
    {%- if blogs[blog_handle].articles.size > 0 -%}
      <div class="blog-grid" data-stagger>
        {%- for article in blogs[blog_handle].articles limit: section.settings.articles_count -%}
          <article class="article-card">
            {%- if article.image != blank -%}
              <a href="{{ article.url }}" class="article-card__image" aria-hidden="true" tabindex="-1">
                {{ article.image | image_url: width: 800 | image_tag: alt: article.image.alt, loading: 'lazy', width: 800, height: 450 }}
              </a>
            {%- endif -%}
            {%- if article.tags.size > 0 -%}<p class="article-card__category">{{ article.tags.first }}</p>{%- endif -%}
            <h3 class="article-card__title"><a href="{{ article.url }}">{{ article.title }}</a></h3>
            {%- if article.excerpt != blank -%}
              <p class="article-card__excerpt">{{ article.excerpt | strip_html | truncate: 120 }}</p>
            {%- endif -%}
            <p class="article-card__meta">{{ article.published_at | date: '%B %d, %Y' }} &middot; {{ article.author }}</p>
          </article>
        {%- endfor -%}
      </div>
      {%- if section.settings.show_view_all -%}
        <div style="text-align:center;margin-top:2.5rem;">
          <a href="{{ blogs[blog_handle].url }}" class="btn btn--secondary">{{ section.settings.btn_label | default: 'View all posts' }}</a>
        </div>
      {%- endif -%}
    {%- endif -%}
  </div>
</section>

{% schema %}
{
  "name": "Blog posts",
  "tag": "section",
  "settings": [
    { "type": "blog", "id": "blog", "label": "Blog" },
    { "type": "range", "id": "articles_count", "min": 2, "max": 6, "step": 1, "label": "Number of articles", "default": 3 },
    { "type": "select", "id": "align", "label": "Heading alignment", "options": [{ "value": "left", "label": "Left" }, { "value": "center", "label": "Center" }], "default": "left" },
    { "type": "text", "id": "eyebrow", "label": "Eyebrow" },
    { "type": "text", "id": "heading", "label": "Heading", "default": "From the Blog" },
    { "type": "checkbox", "id": "show_view_all", "label": "Show 'View all' button", "default": true },
    { "type": "text", "id": "btn_label", "label": "Button label", "default": "View all posts" }
  ],
  "presets": [{ "name": "Blog posts" }]
}
{% endschema %}
