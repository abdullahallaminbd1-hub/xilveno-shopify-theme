<section class="section-padding" id="lookbook-{{ section.id }}">
  <div class="page-container">
    {%- if section.settings.heading != blank -%}
      <div class="section-header section-header--center" style="margin-bottom:2rem;">
        {%- if section.settings.eyebrow != blank -%}<span class="section-eyebrow animate-on-scroll">{{ section.settings.eyebrow }}</span>{%- endif -%}
        <h2 class="section-title h2 animate-on-scroll animate-on-scroll--delay-1">{{ section.settings.heading }}</h2>
      </div>
    {%- endif -%}
    <div class="lookbook-grid" data-stagger>
      {%- for block in section.blocks -%}
        {%- if block.type == 'image' -%}
          {%- if block.settings.link != blank -%}<a href="{{ block.settings.link }}" class="lookbook-item" {{ block.shopify_attributes }} aria-label="{{ block.settings.caption | default: 'View' }}">{%- else -%}<div class="lookbook-item" {{ block.shopify_attributes }}>{%- endif -%}
            {%- if block.settings.image != blank -%}
              {{ block.settings.image | image_url: width: 800 | image_tag: alt: block.settings.caption, loading: 'lazy', width: 800 }}
            {%- else -%}
              <div style="background:var(--color-surface-2);width:100%;height:100%;min-height:300px;"></div>
            {%- endif -%}
            <div class="lookbook-item__overlay" aria-hidden="true">
              {%- if block.settings.caption != blank -%}
                <span style="color:#fff;font-size:0.875rem;font-weight:500;padding:0.5rem 1rem;background:rgba(0,0,0,0.4);border-radius:var(--radius-full);">{{ block.settings.caption }}</span>
              {%- endif -%}
            </div>
          {%- if block.settings.link != blank -%}</a>{%- else -%}</div>{%- endif -%}
        {%- endif -%}
      {%- endfor -%}
    </div>
  </div>
</section>
{% schema %}
{
  "name": "Lookbook grid",
  "tag": "section",
  "settings": [
    { "type": "text", "id": "eyebrow", "label": "Eyebrow", "default": "Style Inspiration" },
    { "type": "text", "id": "heading", "label": "Heading", "default": "The Lookbook" }
  ],
  "blocks": [
    {
      "type": "image",
      "name": "Image",
      "settings": [
        { "type": "image_picker", "id": "image", "label": "Image" },
        { "type": "text", "id": "caption", "label": "Caption (optional)" },
        { "type": "url", "id": "link", "label": "Link (optional)" }
      ]
    }
  ],
  "presets": [
    {
      "name": "Lookbook grid",
      "blocks": [
        { "type": "image" }, { "type": "image" }, { "type": "image" },
        { "type": "image" }, { "type": "image" }, { "type": "image" }
      ]
    }
  ]
}
{% endschema %}
