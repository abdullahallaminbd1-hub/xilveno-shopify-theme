<div class="drawer-backdrop" data-drawer-close></div>
<aside class="cart-drawer" aria-label="Cart" data-cart-drawer>
  <header class="drawer__header"><h2 class="drawer__title">Cart <span class="drawer__meta"><span data-cart-count>{{ cart.item_count }}</span> items</span></h2><button class="icon-button" data-drawer-close aria-label="Close cart">{% render 'icon', icon: 'close' %}</button></header>
  <div class="drawer__body" data-cart-body>
    {%- assign has_pair = false -%}{%- for it in cart.items -%}{%- if it.quantity >= 2 -%}{%- assign has_pair = true -%}{%- endif -%}{%- endfor -%}
    <div class="reward-strip"><p class="reward-strip__lead">{% if cart.total_price >= 7500 %}You have unlocked free shipping{% else %}Add {{ 7500 | minus: cart.total_price | money }} more to unlock free shipping{% endif %}</p><div class="reward-strip__bar"><i style="width:{% if cart.total_price >= 7500 %}100{% else %}{{ cart.total_price | times: 100.0 | divided_by: 7500 | round }}{% endif %}%"></i></div><ul class="reward-strip__steps"><li class="reward-step{% if cart.total_price >= 7500 %} is-done{% endif %}"><span class="reward-step__dot">{% render 'icon', icon: 'truck' %}</span>Free shipping</li><li class="reward-step{% if has_pair %} is-done{% endif %}"><span class="reward-step__dot">{% render 'icon', icon: 'check' %}</span>Buy 2 &mdash; 2% off</li><li class="reward-step{% if cart.total_price >= 7500 %} is-done{% endif %}"><span class="reward-step__dot">{% render 'icon', icon: 'gift' %}</span>Free gift</li></ul></div>
    {% if cart.item_count == 0 %}<div class="empty-state"><div class="empty-state__mark">◇</div><h3>Your cart is empty</h3><p>Discover a small upgrade for your daily ritual.</p><a class="button button--dark" href="{{ routes.all_products_collection_url }}">Continue shopping</a></div>{% else %}<div class="cart-items">{% for item in cart.items %}<div class="cart-item"><div class="cart-item__image">{% if item.image %}{{ item.image | image_url: width: 180 | image_tag }}{% endif %}</div><div class="cart-item__main"><div class="cart-item__head"><h3 class="cart-item__title">{{ item.product.title }}</h3><button type="button" class="cart-item__remove" data-remove-item data-line="{{ forloop.index }}" aria-label="Remove {{ item.product.title | escape }}"><svg viewBox="0 0 24 24" aria-hidden="true"><path d="M4 7h16M10 11v6M14 11v6"/><path d="M6.5 7l.9 11.1A2 2 0 0 0 9.4 20h5.2a2 2 0 0 0 2-1.9L17.5 7"/><path d="M9.5 7V5.2A1.2 1.2 0 0 1 10.7 4h2.6a1.2 1.2 0 0 1 1.2 1.2V7"/></svg></button></div>{% unless item.variant.title == 'Default Title' %}<p class="cart-item__variant">{{ item.variant.title }}</p>{% endunless %}<div class="cart-item__foot"><div class="quantity-control"><button type="button" data-cart-change data-line="{{ forloop.index }}" data-quantity="{{ item.quantity | minus: 1 }}" aria-label="Decrease quantity of {{ item.product.title | escape }}">−</button><span>{{ item.quantity }}</span><button type="button" data-cart-change data-line="{{ forloop.index }}" data-quantity="{{ item.quantity | plus: 1 }}" aria-label="Increase quantity of {{ item.product.title | escape }}">＋</button></div><span class="cart-item__price">{{ item.final_line_price | money }}</span></div></div></div>{% endfor %}</div>{% endif %}
    <div class="drawer-recommendations"><span class="eyebrow">You may also like</span><div><a href="{{ routes.all_products_collection_url }}">Facial tools</a><a href="{{ routes.all_products_collection_url }}">Hair tools</a><a href="{{ routes.all_products_collection_url }}">Gift sets</a></div></div>
  </div>
  <footer class="drawer__footer"><p class="cart-note{% if cart.total_discount > 0 %} cart-note--applied{% endif %}" data-discount-note aria-live="polite">{% if cart.total_discount > 0 %}Discount applied — you saved {{ cart.total_discount | money }}{% endif %}</p><form class="discount-form" data-discount-form><input type="text" name="discount" placeholder="Enter your discount code" aria-label="Discount code"><button type="submit">Apply</button></form><div class="drawer-total"><span>Subtotal</span><strong>{{ cart.total_price | money }}</strong></div>{% if cart.total_discount > 0 %}<p class="drawer-savings">Includes {{ cart.total_discount | money }} discount</p>{% endif %}<a class="button button--accent button--full drawer__checkout" href="/checkout">Check out &middot; {{ cart.total_price | money }}</a><p class="payment-note">Taxes and shipping calculated at checkout<br>Visa &middot; Mastercard &middot; Amex &middot; Shop Pay</p></footer>
</aside>