{%- comment -%} Cart Drawer — rendered in theme.liquid, populated by AJAX {%- endcomment -%}
<div
  class="cart-drawer"
  id="cart-drawer"
  role="dialog"
  aria-modal="true"
  aria-label="{{ 'sections.cart.title' | t | default: 'Cart' }}"
  inert
>
  <div class="cart-drawer__header">
    <h2 class="cart-drawer__title">{{ 'sections.cart.title' | t | default: 'Your cart' }} <span style="color:var(--color-fg-muted);font-weight:400;font-size:0.875rem;">(<span data-cart-count>{{ cart.item_count }}</span>)</span></h2>
    <button class="cart-drawer__close" aria-label="{{ 'accessibility.close' | t | default: 'Close cart' }}">
      <svg width="16" height="16" viewBox="0 0 16 16" fill="none" aria-hidden="true">
        <path d="M2 2l12 12M14 2L2 14" stroke="currentColor" stroke-width="1.5" stroke-linecap="round"/>
      </svg>
    </button>
  </div>

  <div class="cart-drawer__body" id="cart-drawer-items" aria-live="polite" aria-label="Cart items">
    {%- if cart.item_count == 0 -%}
      <div class="cart-empty">
        <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" width="48" height="48" aria-hidden="true">
          <path d="M3 6h2l3.6 7.59L7.5 15a1 1 0 0 0 1 1H19m-2 2a1 1 0 1 0 2 0 1 1 0 0 0-2 0m-7 0a1 1 0 1 0 2 0 1 1 0 0 0-2 0M1 1h3.27L5.64 8M5.64 8L8 14h10l2.73-10H5.64z" stroke-linecap="round" stroke-linejoin="round"/>
        </svg>
        <p class="cart-empty__title">{{ 'sections.cart.empty' | t | default: 'Your cart is empty' }}</p>
        <p class="cart-empty__text">Add something beautiful to get started.</p>
        <a href="{{ routes.all_products_collection_url }}" class="btn btn--primary btn--sm" style="margin-top:0.5rem">Shop now</a>
      </div>
    {%- else -%}
      {%- for item in cart.items -%}
        <div class="cart-item" data-key="{{ item.key }}">
          <div class="cart-item__image">
            <a href="{{ item.url }}">
              {%- if item.image != blank -%}
                {{ item.image | image_url: width: 160 | image_tag: alt: item.title, loading: 'lazy', width: 80, height: 80 }}
              {%- endif -%}
            </a>
          </div>
          <div class="cart-item__details">
            <a href="{{ item.url }}" class="cart-item__title">{{ item.product.title }}</a>
            {%- unless item.variant.title == 'Default Title' -%}
              <p class="cart-item__variant">{{ item.variant.title }}</p>
            {%- endunless -%}
            <div class="cart-item__row">
              <div class="cart-item__qty">
                <button class="cart-item__qty-btn" data-qty-dec aria-label="{{ 'products.product.quantity.decrease' | t }}">
                  <svg width="14" height="14" viewBox="0 0 14 14" fill="currentColor" aria-hidden="true"><rect x="2" y="6.5" width="10" height="1" rx="0.5"/></svg>
                </button>
                <input type="number" class="cart-item__qty-input" value="{{ item.quantity }}" min="0" data-key="{{ item.key }}" aria-label="{{ 'products.product.quantity.input_label' | t | default: 'Quantity' }}">
                <button class="cart-item__qty-btn" data-qty-inc aria-label="{{ 'products.product.quantity.increase' | t }}">
                  <svg width="14" height="14" viewBox="0 0 14 14" fill="currentColor" aria-hidden="true"><path d="M7.5 2a.5.5 0 0 0-1 0v4.5H2a.5.5 0 0 0 0 1h4.5V12a.5.5 0 0 0 1 0V7.5H12a.5.5 0 0 0 0-1H7.5V2z"/></svg>
                </button>
              </div>
              <span class="cart-item__price">{{ item.final_line_price | money }}</span>
            </div>
            <button class="cart-item__remove" data-key="{{ item.key }}" aria-label="{{ 'sections.cart.remove' | t | default: 'Remove' }} {{ item.product.title }}">
              {{ 'sections.cart.remove' | t | default: 'Remove' }}
            </button>
          </div>
        </div>
      {%- endfor -%}
    {%- endif -%}
  </div>

  <div class="cart-drawer__footer">
    {%- if settings.free_shipping_threshold > 0 -%}
      <div class="free-shipping-bar" data-free-shipping-threshold="{{ settings.free_shipping_threshold }}" aria-label="Free shipping progress">
        <p class="free-shipping-bar__label">
          {%- if cart.total_price >= settings.free_shipping_threshold -%}
            <strong>🎉 You've unlocked free shipping!</strong>
          {%- else -%}
            {%- assign remaining = settings.free_shipping_threshold | minus: cart.total_price -%}
            Spend <strong>{{ remaining | money }}</strong> more for free shipping
          {%- endif -%}
        </p>
        <div class="free-shipping-bar__track" role="progressbar" aria-valuemin="0" aria-valuemax="{{ settings.free_shipping_threshold }}" aria-valuenow="{{ cart.total_price }}">
          {%- assign pct = cart.total_price | times: 100 | divided_by: settings.free_shipping_threshold -%}
          {%- if pct > 100 -%}{%- assign pct = 100 -%}{%- endif -%}
          <div class="free-shipping-bar__fill" style="width:{{ pct }}%;"></div>
        </div>
      </div>
    {%- endif -%}

    <form data-discount-form style="margin-bottom:1rem;">
      <div class="discount-field">
        <input
          type="text"
          class="discount-field__input"
          placeholder="{{ 'cart.general.discount_code' | t | default: 'Discount code' }}"
          aria-label="{{ 'cart.general.discount_code' | t | default: 'Discount code' }}"
          autocomplete="off"
        >
        <button type="submit" class="btn btn--ghost btn--sm discount-field__btn">Apply</button>
      </div>
    </form>

    <div class="cart-totals" aria-label="Cart totals">
      <div class="cart-totals__row cart-totals__row--total">
        <span>{{ 'cart.general.total' | t | default: 'Total' }}</span>
        <span data-cart-total>{{ cart.total_price | money }}</span>
      </div>
    </div>

    <p class="cart-totals__note">{{ 'cart.general.taxes_and_shipping' | t | default: 'Taxes and shipping calculated at checkout' }}</p>

    <a
      href="{{ routes.checkout_url }}"
      class="btn btn--primary btn--full btn--lg"
      aria-label="{{ 'cart.general.checkout' | t | default: 'Proceed to checkout' }}"
    >
      {{ 'cart.general.checkout' | t | default: 'Checkout' }}
    </a>

    <a href="{{ routes.cart_url }}" style="display:block;text-align:center;margin-top:0.75rem;font-size:0.8125rem;color:var(--color-fg-muted);">
      {{ 'cart.general.view_cart' | t | default: 'View full cart' }}
    </a>
  </div>
</div>
