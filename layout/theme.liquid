<!doctype html>
<html lang="{{ request.locale.iso_code }}">
  <head>
    <meta charset="utf-8">
    <meta name="viewport" content="width=device-width,initial-scale=1">
    <link rel="canonical" href="{{ canonical_url }}">
    <title>{{ page_title }}{% unless page_title contains shop.name %} — {{ shop.name }}{% endunless %}</title>
    {{ content_for_header }}
    {{ 'theme.css' | asset_url | stylesheet_tag }}
    <style>
      :root{
        --ink: {{ settings.color_ink | default: '#25211f' }};
        --accent: {{ settings.color_accent | default: '#d9755f' }};
        --sand: {{ settings.color_sand | default: '#f5f0e9' }};
      }
    </style>
  </head>
  <body class="template-{{ template.name }}">
    <a class="skip-link" href="#MainContent">Skip to content</a>
    {% section 'announcement-bar' %}
    {% section 'header' %}
    <main id="MainContent" role="main">{{ content_for_layout }}</main>
    {% section 'footer' %}
    {% render 'cart-drawer' %}
    <script src="{{ 'theme.js' | asset_url }}" defer></script>
  </body>
</html>