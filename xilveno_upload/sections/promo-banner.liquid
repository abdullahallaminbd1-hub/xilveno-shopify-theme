<section class="section-padding--sm" id="section-{{ section.id }}">
  <div class="page-container">
    <div class="promo-banner animate-on-scroll">
      {%- if section.settings.image != blank -%}
        {{ section.settings.image | image_url: width: 1600 | image_tag: class: 'promo-banner__bg', alt: section.settings.title, loading: 'lazy', width: 1600, height: 640 }}
        <div class="promo-banner__overlay" aria-hidden="true"></div>
      {%- else -%}
        <div class="promo-banner__bg" style="background:{{ section.settings.bg_color | default: '#0a0a0a' }};"></div>
      {%- endif -%}
      <div class="promo-banner__content" style="{% if section.settings.content_align == 'right' %}margin-left:auto;{% elsif section.settings.content_align == 'center' %}margin:0 auto;text-align:center;{% endif %}">
        {%- if section.settings.tag != blank -%}<span class="promo-banner__tag">{{ section.settings.tag }}</span>{%- endif -%}
        {%- if section.settings.title != blank -%}<h2 class="promo-banner__title">{{ section.settings.title }}</h2>{%- endif -%}
        {%- if section.settings.text != blank -%}<p class="promo-banner__text">{{ section.settings.text }}</p>{%- endif -%}
        {%- if section.settings.btn_label != blank -%}
          <a href="{{ section.settings.btn_link | default: '#' }}" class="btn" style="background:#fff;color:#0a0a0a;border-color:#fff;">{{ section.settings.btn_label }}</a>
        {%- endif -%}
      </div>
    </div>
  </div>
</section>

{% schema %}
{
  "name": "Promotional banner",
  "tag": "section",
  "settings": [
    { "type": "image_picker", "id": "image", "label": "Background image" },
    { "type": "color", "id": "bg_color", "label": "Fallback background color", "default": "#0a0a0a" },
    { "type": "select", "id": "content_align", "label": "Content alignment", "options": [{ "value": "left", "label": "Left" }, { "value": "center", "label": "Center" }, { "value": "right", "label": "Right" }], "default": "left" },
    { "type": "text", "id": "tag", "label": "Tag / label", "default": "Limited time" },
    { "type": "textarea", "id": "title", "label": "Title", "default": "Up to 40% off\nNew Season Styles" },
    { "type": "text", "id": "text", "label": "Supporting text", "default": "Shop the latest arrivals before they sell out." },
    { "type": "text", "id": "btn_label", "label": "Button label", "default": "Shop the sale" },
    { "type": "url", "id": "btn_link", "label": "Button link" }
  ],
  "presets": [{ "name": "Promotional banner" }]
}
{% endschema %}
