<section class="section-padding" aria-labelledby="testimonials-{{ section.id }}">
  <div class="page-container">
    <div class="section-header section-header--center">
      {%- if section.settings.eyebrow != blank -%}<span class="section-eyebrow animate-on-scroll">{{ section.settings.eyebrow }}</span>{%- endif -%}
      {%- if section.settings.heading != blank -%}
        <h2 class="section-title h2 animate-on-scroll animate-on-scroll--delay-1" id="testimonials-{{ section.id }}">{{ section.settings.heading }}</h2>
      {%- endif -%}
    </div>
    <div class="testimonials-grid" data-stagger>
      {%- for block in section.blocks -%}
        {%- if block.type == 'testimonial' -%}
          <article class="testimonial-card" {{ block.shopify_attributes }}>
            <div class="testimonial-card__stars" aria-label="{{ block.settings.rating }} out of 5 stars">
              {%- for i in (1..5) -%}
                <svg width="14" height="14" viewBox="0 0 14 14" fill="{% if i <= block.settings.rating %}#f59e0b{% else %}#e5e7eb{% endif %}" aria-hidden="true">
                  <path d="M7 1l1.545 3.13L12 4.636l-2.5 2.436.59 3.443L7 8.885l-3.09 1.63L4.5 7.072 2 4.636l3.455-.506z"/>
                </svg>
              {%- endfor -%}
            </div>
            <blockquote class="testimonial-card__text">
              <p>{{ block.settings.quote }}</p>
            </blockquote>
            <footer class="testimonial-card__author">
              {%- if block.settings.avatar != blank -%}
                <div class="testimonial-card__avatar">
                  {{ block.settings.avatar | image_url: width: 80 | image_tag: alt: block.settings.name, loading: 'lazy', width: 40, height: 40 }}
                </div>
              {%- else -%}
                <div class="testimonial-card__avatar-placeholder" aria-hidden="true">{{ block.settings.name | slice: 0 | upcase }}</div>
              {%- endif -%}
              <div>
                <p class="testimonial-card__name">{{ block.settings.name }}</p>
                {%- if block.settings.meta != blank -%}<p class="testimonial-card__meta">{{ block.settings.meta }}</p>{%- endif -%}
              </div>
            </footer>
          </article>
        {%- endif -%}
      {%- endfor -%}
    </div>
  </div>
</section>

{% schema %}
{
  "name": "Testimonials",
  "tag": "section",
  "settings": [
    { "type": "text", "id": "eyebrow", "label": "Eyebrow", "default": "What customers say" },
    { "type": "text", "id": "heading", "label": "Heading", "default": "Loved by thousands" }
  ],
  "blocks": [
    {
      "type": "testimonial",
      "name": "Testimonial",
      "settings": [
        { "type": "range", "id": "rating", "min": 1, "max": 5, "step": 1, "label": "Star rating", "default": 5 },
        { "type": "textarea", "id": "quote", "label": "Quote", "default": "Absolutely love the quality. Fast shipping and everything arrived perfectly packaged. Will definitely order again!" },
        { "type": "image_picker", "id": "avatar", "label": "Author avatar (optional)" },
        { "type": "text", "id": "name", "label": "Author name", "default": "Sarah M." },
        { "type": "text", "id": "meta", "label": "Author meta (e.g. Verified buyer)", "default": "Verified buyer" }
      ]
    }
  ],
  "presets": [
    {
      "name": "Testimonials",
      "blocks": [
        { "type": "testimonial", "settings": { "quote": "Absolutely love the quality. Fast shipping and everything arrived perfectly packaged!", "name": "Sarah M.", "meta": "Verified buyer" } },
        { "type": "testimonial", "settings": { "quote": "The home decor pieces are stunning. Exactly as pictured and the packaging was beautiful.", "name": "James T.", "meta": "Verified buyer" } },
        { "type": "testimonial", "settings": { "quote": "Great customer service and the products are exactly what I was looking for. Highly recommend!", "name": "Priya K.", "meta": "Verified buyer" } }
      ]
    }
  ]
}
{% endschema %}
