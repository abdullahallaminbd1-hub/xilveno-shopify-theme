<section class="section-padding" id="faq-{{ section.id }}">
  <div class="page-container page-container--narrow">
    <div class="section-header section-header--center">
      {%- if section.settings.eyebrow != blank -%}<span class="section-eyebrow animate-on-scroll">{{ section.settings.eyebrow }}</span>{%- endif -%}
      {%- if section.settings.heading != blank -%}
        <h2 class="section-title h2 animate-on-scroll animate-on-scroll--delay-1">{{ section.settings.heading }}</h2>
      {%- endif -%}
    </div>
    <div class="faq-list" role="list">
      {%- for block in section.blocks -%}
        {%- if block.type == 'faq_item' -%}
          {%- assign faq_id = 'faq-answer-' | append: section.id | append: '-' | append: forloop.index -%}
          <div class="faq-item" role="listitem" {{ block.shopify_attributes }}>
            <button
              class="faq-question"
              aria-expanded="false"
              aria-controls="{{ faq_id }}"
              id="{{ faq_id }}-trigger"
            >
              {{ block.settings.question }}
              <svg width="18" height="18" viewBox="0 0 18 18" fill="none" aria-hidden="true">
                <path d="M9 3v12M3 9h12" stroke="currentColor" stroke-width="1.5" stroke-linecap="round"/>
              </svg>
            </button>
            <div
              class="faq-answer"
              id="{{ faq_id }}"
              role="region"
              aria-labelledby="{{ faq_id }}-trigger"
            >
              {{ block.settings.answer }}
            </div>
          </div>
        {%- endif -%}
      {%- endfor -%}
    </div>
  </div>
</section>

{% schema %}
{
  "name": "FAQ accordion",
  "tag": "section",
  "settings": [
    { "type": "text", "id": "eyebrow", "label": "Eyebrow", "default": "Got questions?" },
    { "type": "text", "id": "heading", "label": "Heading", "default": "Frequently asked questions" }
  ],
  "blocks": [
    {
      "type": "faq_item",
      "name": "FAQ item",
      "settings": [
        { "type": "text", "id": "question", "label": "Question", "default": "How long does shipping take?" },
        { "type": "richtext", "id": "answer", "label": "Answer", "default": "<p>Standard shipping typically takes 5–10 business days. Express options are available at checkout. We ship to most countries worldwide.</p>" }
      ]
    }
  ],
  "presets": [
    {
      "name": "FAQ accordion",
      "blocks": [
        { "type": "faq_item", "settings": { "question": "How long does shipping take?", "answer": "<p>Standard shipping takes 5–10 business days. Express delivery is available at checkout.</p>" } },
        { "type": "faq_item", "settings": { "question": "What is your return policy?", "answer": "<p>We accept returns within 30 days of delivery. Items must be unworn and in original condition. Contact us to initiate a return.</p>" } },
        { "type": "faq_item", "settings": { "question": "How do I track my order?", "answer": "<p>You'll receive a tracking link via email once your order ships. You can also view order status in your account dashboard.</p>" } },
        { "type": "faq_item", "settings": { "question": "Do you ship internationally?", "answer": "<p>Yes! We ship to most countries. International delivery times vary by location, typically 10–21 business days.</p>" } }
      ]
    }
  ]
}
{% endschema %}
